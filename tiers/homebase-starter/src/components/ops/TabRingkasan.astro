---
export interface Props {
  penName: string;
  tagline: string;
}
const { penName, tagline } = Astro.props;
---

<div>
  <div
    style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:28px"
  >
    <div>
      <h1
        style="margin:0 0 6px;font-family:'Playfair Display',serif;font-size:32px;font-weight:600;color:#3B2A28"
      >
        Selamat pagi, {penName.split(' ')[0]}
      </h1>
      <p style="margin:0;font-size:14px;color:#7A5A50">
        {tagline} &middot; simulasi dari penyimpanan lokal.
      </p>
    </div>
    <a
      href="?tab=rilis"
      data-go-rilis
      style="flex:none;display:flex;align-items:center;height:48px;padding:0 22px;background:#7A3341;color:#FBF6EF;border:none;border-radius:12px;font-family:Lora,serif;font-size:14px;font-weight:600;cursor:pointer;text-decoration:none"
    >
      + Umumkan Bab Baru
    </a>
  </div>

  <!-- Last Chapter Card -->
  <div
    style="background:#5C2430;border-radius:18px;padding:22px 24px;color:#F4E3DE;margin-bottom:28px"
  >
    <p
      style="margin:0 0 6px;font-size:11px;letter-spacing:.14em;color:#D8A7A4;font-weight:600"
    >
      BAB TERBIT TERAKHIR
    </p>
    <p id="last-chapter-line" style="margin:0;font-family:'Playfair Display',serif;font-size:19px;font-weight:600;line-height:1.35;color:#FBF6EF">
      Belum ada bab dirilis dari dashboard ini.
    </p>
    <p id="last-chapter-date" style="margin:8px 0 0;font-size:12px;color:#C99B94">
      Gunakan tab Kabar Rilis untuk mengumumkan bab baru.
    </p>
  </div>

  <!-- Quick Stats (static demo placeholders) -->
  <div
    style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:28px"
  >
    {(
      [
        { label: 'Karya', angka: '4', unit: '' },
        { label: 'Bonus konten', angka: '3', unit: '' },
        { label: 'Total pembaca KBM', angka: '32 jt+', unit: '' },
      ] as const
    ).map((s) => (
      <div
        style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:16px;padding:20px 22px"
      >
        <p
          style="margin:0 0 8px;font-size:12px;letter-spacing:.06em;color:#8A6A5E"
        >
          {s.label}
        </p>
        <p
          style="margin:0;font-family:'Playfair Display',serif;font-size:30px;font-weight:700;color:#5C2430;line-height:1"
        >
          {s.angka}
        </p>
      </div>
    ))}
  </div>

  <!-- Quick Actions -->
  <div
    style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;padding:22px 24px"
  >
    <h2
      style="margin:0 0 12px;font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:#3B2A28"
    >
      Aksi cepat
    </h2>
    <div style="display:flex;flex-direction:column;gap:8px">
      <a
        href="?tab=rilis"
        style="display:flex;align-items:center;justify-content:space-between;height:46px;padding:0 16px;background:#F4E3DE;border:none;border-radius:11px;font-family:Lora,serif;font-size:14px;color:#4A3833;cursor:pointer;text-decoration:none"
      >
        <span>Umumkan bab baru</span>
        <span style="color:#7A3341">&rarr;</span>
      </a>
      <a
        href="?tab=database"
        style="display:flex;align-items:center;justify-content:space-between;height:46px;padding:0 16px;background:#F4E3DE;border:none;border-radius:11px;font-family:Lora,serif;font-size:14px;color:#4A3833;cursor:pointer;text-decoration:none"
      >
        <span>Lihat database pembaca</span>
        <span style="color:#7A3341">&rarr;</span>
      </a>
      <a
        href="?tab=tema"
        style="display:flex;align-items:center;justify-content:space-between;height:46px;padding:0 16px;background:#F4E3DE;border:none;border-radius:11px;font-family:Lora,serif;font-size:14px;color:#4A3833;cursor:pointer;text-decoration:none"
      >
        <span>Ganti tema situs</span>
        <span style="color:#7A3341">&rarr;</span>
      </a>
    </div>
  </div>
</div>

<script>
  // Client-side: hydrate last chapter from localStorage
  import { loadDemoState } from '../../lib/demo-store';

  const state = loadDemoState('starter', []);
  const el = document.getElementById('last-chapter-line');
  const dateEl = document.getElementById('last-chapter-date');
  if (el && dateEl && state.history && state.history.length > 0) {
    const ch = state.history[0];
    el.textContent = `${ch.workTitle} \u2014 ${ch.title}`;
    dateEl.textContent = `Dirilis dari dashboard ini &middot; ${ch.date}`;
  }
</script>
