---
import type { Work } from '../../lib/types';

export interface Props {
  works: Work[];
}

const { works } = Astro.props;
---

<div>
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px">
    <div>
      <h1 style="margin:0 0 6px;font-family:'Playfair Display',serif;font-size:32px;font-weight:600;color:#3B2A28">
        Karya
      </h1>
      <p style="margin:0;font-size:14px;color:#7A5A50">
        {works.length} karya &middot; semua dibaca di KBM App.
      </p>
    </div>
  </div>

  <div style="display:flex;flex-direction:column;gap:10px">
    {works.map((work) => (
      <div
        style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:14px;padding:18px 22px;display:flex;align-items:center;gap:14px"
      >
        <div
          class="karya-cover-thumb"
          style={`flex:none;width:46px;aspect-ratio:2/3;border-radius:4px;display:flex;align-items:center;justify-content:center;padding:5px;background:${work.coverBg}`}
        >
          <span style="font-family:'Playfair Display',serif;font-size:8px;font-weight:600;line-height:1.3;color:#FBF6EF;text-align:center">
            {work.title}
          </span>
        </div>
        <div style="flex:1;min-width:0">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px">
            <span style="font-size:12px;letter-spacing:.06em;color:#8A6A5E;font-weight:600">{work.genre}</span>
            <span style="font-size:10px;letter-spacing:.08em;color:#7A3341;font-weight:600;background:#F4E3DE;border-radius:999px;padding:3px 8px">{work.status}</span>
            {work.series && (
              <span style="font-size:10px;letter-spacing:.08em;color:#8A6A5E;font-weight:600">({work.series})</span>
            )}
          </div>
          <h3 style="margin:0 0 3px;font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:#3B2A28;line-height:1.3">
            {work.title}
          </h3>
          <p style="margin:0;font-size:13px;color:#6A5248;font-style:italic">
            &ldquo;{work.hook}&rdquo;
          </p>
          <p style="margin:4px 0 0;font-size:12px;color:#9A8078">
            {work.readers}
          </p>
        </div>
        <div style="flex:none;display:flex;flex-direction:column;gap:6px">
          <a
            href={work.kbmUrl}
            target="_blank"
            rel="noopener noreferrer"
            style="display:flex;align-items:center;justify-content:center;min-height:38px;padding:0 14px;background:none;border:1.5px solid #7A3341;color:#7A3341;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap"
          >
            Buka KBM &rarr;
          </a>
          <a
            href={`/karya/${work.slug}`}
            style="display:flex;align-items:center;justify-content:center;min-height:38px;padding:0 14px;background:#7A3341;color:#FBF6EF;border:none;border-radius:10px;font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap"
          >
            Halaman Karya
          </a>
        </div>
      </div>
    ))}
  </div>

  <p style="margin:16px 2px 0;font-size:12px;color:#9A8078">
    Halaman per karya hanya menampilkan judul, hook, genre &amp; tombol ke KBM &mdash; tanpa isi bab.
  </p>
</div>
