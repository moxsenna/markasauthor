---
import type { BonusItem } from '../../lib/types';

export interface Props {
  bonuses: BonusItem[];
}

const { bonuses } = Astro.props;
---

<div>
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px">
    <div>
      <h1 style="margin:0 0 6px;font-family:'Playfair Display',serif;font-size:32px;font-weight:600;color:#3B2A28">
        Ruang Bonus
      </h1>
      <p style="margin:0;font-size:14px;color:#7A5A50">
        {bonuses.length} konten bonus &middot; kelola visibilitas publik.
      </p>
    </div>
  </div>

  <div style="display:flex;flex-direction:column;gap:12px">
    {bonuses.map((b) => (
      <div
        style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:16px;padding:18px 22px;display:flex;align-items:center;gap:14px"
      >
        <div style="flex:1;min-width:0">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
            <span style="font-size:10px;letter-spacing:.14em;color:#B98A7C;font-weight:600">{b.jenis}</span>
            <span
              style={`font-size:10px;letter-spacing:.1em;font-weight:600;color:${b.published ? '#1E7A57' : '#8A6A5E'};border:1px solid ${b.published ? 'rgba(30,122,87,.4)' : 'rgba(122,51,65,.25)'};border-radius:999px;padding:3px 8px`}
            >
              {b.published ? 'PUBLIK' : 'DRAFT'}
            </span>
          </div>
          <h3 style="margin:0 0 3px;font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:#3B2A28;line-height:1.3">
            {b.title}
          </h3>
          <p style="margin:0;font-size:12px;color:#9A8078;font-style:italic">
            dari &ldquo;{b.karya}&rdquo; &middot; {b.opens} buka
          </p>
          <p style="margin:6px 0 0;font-size:13px;line-height:1.5;color:#6A5248">
            {b.teaser}
          </p>
        </div>
        <button
          class="bonus-toggle-publish"
          data-bonus-id={b.id}
          data-published={String(b.published)}
          style={`flex:none;min-height:42px;padding:0 18px;border-radius:10px;font-family:Lora,Georgia,serif;font-size:13px;font-weight:600;cursor:pointer;background:${b.published ? '#F4E3DE' : '#7A3341'};color:${b.published ? '#7A3341' : '#FBF6EF'};border:${b.published ? '1.5px solid #7A3341' : 'none'}`}
        >
          {b.published ? 'Sembunyikan' : 'Tampilkan'}
        </button>
      </div>
    ))}
  </div>

  <p style="margin:16px 2px 0;font-size:12px;color:#9A8078">
    Ubah status tampil/sembunyi bersifat lokal &mdash; simulasi dashboard.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.bonus-toggle-publish').forEach((btn) => {
    btn.addEventListener('click', () => {
      const published = btn.dataset.published === 'true';
      const newPublished = !published;
      btn.dataset.published = String(newPublished);
      btn.textContent = newPublished ? 'Sembunyikan' : 'Tampilkan';
      btn.style.background = newPublished ? '#F4E3DE' : '#7A3341';
      btn.style.color = newPublished ? '#7A3341' : '#FBF6EF';
      btn.style.border = newPublished ? '1.5px solid #7A3341' : 'none';

      // Update status badge
      const card = btn.closest('div')?.parentElement;
      const badge = card?.querySelector('span:nth-child(1) > span:nth-child(2)') as HTMLElement | null;
      if (badge) {
        badge.textContent = newPublished ? 'PUBLIK' : 'DRAFT';
        badge.style.color = newPublished ? '#1E7A57' : '#8A6A5E';
        badge.style.borderColor = newPublished ? 'rgba(30,122,87,.4)' : 'rgba(122,51,65,.25)';
      }
    });
  });
</script>
