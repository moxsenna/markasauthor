---
import authorData from '../../data/author.json';
import type { AuthorData } from '../../lib/types';

export interface Props {
  tier?: string;
}

const { tier = 'signature' } = Astro.props;
const author = authorData as AuthorData;
const seed = JSON.stringify(author.universe || null);
---

<div data-ops-universe data-tier={tier}>
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:22px;flex-wrap:wrap">
    <div>
      <h1 style="margin:0 0 6px;font-family:'Playfair Display',serif;font-size:32px;font-weight:600;color:#3B2A28">Semesta</h1>
      <p style="margin:0;font-size:14px;color:#7A5A50">Edit nama, tokoh, timeline, lokasi, trivia — simulasi ops Signature.</p>
    </div>
    <a href="/universe" style="display:flex;align-items:center;height:48px;padding:0 18px;border:1.5px solid #7A3341;color:#7A3341;border-radius:12px;font-size:14px;font-weight:600;text-decoration:none">Lihat publik →</a>
  </div>

  <div id="uni-empty" hidden style="text-align:center;padding:60px 20px;color:#7A5A50">Belum ada data semesta.</div>

  <div id="uni-body">
    <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;padding:20px 22px;margin-bottom:16px;display:flex;flex-direction:column;gap:12px">
      <h2 style="margin:0;font-family:'Playfair Display',serif;font-size:18px">Identitas</h2>
      <label style="font-size:13px;font-weight:600">Nama semesta<input id="uni-name" style="display:block;width:100%;margin-top:6px;height:46px;padding:0 12px;border-radius:10px;border:1px solid rgba(122,51,65,.25);background:#FFFDF9;font-family:Lora,serif;box-sizing:border-box" /></label>
      <label style="font-size:13px;font-weight:600">Blurb<textarea id="uni-blurb" rows="2" style="display:block;width:100%;margin-top:6px;padding:10px 12px;border-radius:10px;border:1px solid rgba(122,51,65,.25);background:#FFFDF9;font-family:Lora,serif;box-sizing:border-box"></textarea></label>
      <button type="button" id="uni-save-meta" style="align-self:flex-start;height:44px;padding:0 18px;background:#7A3341;color:#FBF6EF;border:none;border-radius:11px;font-family:Lora,serif;font-weight:600;cursor:pointer">Simpan identitas</button>
    </div>

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px" id="uni-stats"></div>

    <!-- Characters -->
    <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;padding:20px 22px;margin-bottom:16px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;gap:10px;flex-wrap:wrap">
        <h2 style="margin:0;font-family:'Playfair Display',serif;font-size:18px">Tokoh</h2>
        <button type="button" id="uni-add-char" style="height:40px;padding:0 14px;background:#7A3341;color:#FBF6EF;border:none;border-radius:10px;font-family:Lora,serif;font-size:13px;font-weight:600;cursor:pointer">+ Tokoh</button>
      </div>
      <div id="uni-chars" style="display:flex;flex-direction:column;gap:8px"></div>
    </div>

    <!-- Timeline -->
    <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;padding:20px 22px;margin-bottom:16px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;gap:10px;flex-wrap:wrap">
        <h2 style="margin:0;font-family:'Playfair Display',serif;font-size:18px">Linimasa</h2>
        <button type="button" id="uni-add-tl" style="height:40px;padding:0 14px;background:#7A3341;color:#FBF6EF;border:none;border-radius:10px;font-family:Lora,serif;font-size:13px;font-weight:600;cursor:pointer">+ Entri</button>
      </div>
      <div id="uni-tl" style="display:flex;flex-direction:column;gap:8px"></div>
    </div>

    <!-- Locations -->
    <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;padding:20px 22px;margin-bottom:16px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;gap:10px;flex-wrap:wrap">
        <h2 style="margin:0;font-family:'Playfair Display',serif;font-size:18px">Lokasi</h2>
        <button type="button" id="uni-add-loc" style="height:40px;padding:0 14px;background:#7A3341;color:#FBF6EF;border:none;border-radius:10px;font-family:Lora,serif;font-size:13px;font-weight:600;cursor:pointer">+ Lokasi</button>
      </div>
      <div id="uni-loc" style="display:flex;flex-direction:column;gap:8px"></div>
    </div>

    <!-- Trivia -->
    <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;padding:20px 22px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;gap:10px;flex-wrap:wrap">
        <h2 style="margin:0;font-family:'Playfair Display',serif;font-size:18px">Trivia</h2>
        <button type="button" id="uni-add-tr" style="height:40px;padding:0 14px;background:#7A3341;color:#FBF6EF;border:none;border-radius:10px;font-family:Lora,serif;font-size:13px;font-weight:600;cursor:pointer">+ Trivia</button>
      </div>
      <div id="uni-tr" style="display:flex;flex-direction:column;gap:8px"></div>
    </div>
  </div>
  <p style="margin:14px 2px 0;font-size:12px;color:#9A8078">Semua edit disimpan di localStorage (demo presentasi).</p>
</div>

<script type="application/json" id="uni-seed" set:html={seed} />

<script>
  import { loadContent, saveContent, toast } from '../../lib/demo-store';
  import author from '../../data/author.json';

  type Uni = NonNullable<typeof author.universe>;

  const root = document.querySelector('[data-ops-universe]') as HTMLElement;
  const tier = root?.dataset.tier || 'signature';
  const seed = JSON.parse(document.getElementById('uni-seed')!.textContent || 'null') as Uni | null;

  function get(): Uni | null {
    const c = loadContent(tier, author as any);
    return (c.universe as Uni) || seed;
  }
  function persist(u: Uni) {
    saveContent(tier, { universe: u }, author as any);
    toast('Semesta disimpan');
    render();
  }
  function esc(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function render() {
    const u = get();
    if (!u) {
      document.getElementById('uni-empty')!.hidden = false;
      document.getElementById('uni-body')!.hidden = true;
      return;
    }
    document.getElementById('uni-empty')!.hidden = true;
    document.getElementById('uni-body')!.hidden = false;
    (document.getElementById('uni-name') as HTMLInputElement).value = u.name;
    (document.getElementById('uni-blurb') as HTMLTextAreaElement).value = u.blurb;
    document.getElementById('uni-stats')!.innerHTML = [
      ['Tokoh', u.characters.length],
      ['Linimasa', u.storyTimeline.length],
      ['Lokasi', u.locations.length],
      ['Trivia', u.trivia.length],
    ]
      .map(
        ([l, n]) => `<div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:14px;padding:14px 16px"><p style="margin:0;font-size:12px;color:#8A6A5E">${l}</p><p style="margin:6px 0 0;font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:#5C2430">${n}</p></div>`,
      )
      .join('');

    document.getElementById('uni-chars')!.innerHTML = u.characters
      .map(
        (ch, i) => `<div data-i="${i}" style="display:flex;gap:10px;align-items:center;border-bottom:1px solid rgba(122,51,65,.08);padding-bottom:8px;flex-wrap:wrap">
        <div style="width:36px;height:36px;border-radius:50%;background:#7A3341;color:#FBF6EF;display:flex;align-items:center;justify-content:center;font-weight:600">${esc(ch.name[0])}</div>
        <div style="flex:1;min-width:140px"><p style="margin:0;font-weight:600">${esc(ch.name)}</p><p style="margin:2px 0 0;font-size:12px;color:#9A8078">${esc(ch.role)}</p></div>
        <button type="button" data-act="edit" style="min-height:34px;padding:0 12px;border-radius:8px;border:1.5px solid #7A3341;background:none;color:#7A3341;cursor:pointer;font-size:12px;font-weight:600">Edit</button>
        <button type="button" data-act="del" style="min-height:34px;padding:0 12px;border-radius:8px;border:1.5px solid #B0483C;background:none;color:#B0483C;cursor:pointer;font-size:12px;font-weight:600">Hapus</button>
      </div>`,
      )
      .join('');

    document.getElementById('uni-tl')!.innerHTML = u.storyTimeline
      .map(
        (t, i) => `<div data-i="${i}" style="display:flex;gap:10px;align-items:center;border-bottom:1px solid rgba(122,51,65,.08);padding-bottom:8px;flex-wrap:wrap">
        <div style="flex:1;min-width:160px"><p style="margin:0;font-weight:600">${esc(t.title)}</p><p style="margin:2px 0 0;font-size:12px;color:#9A8078">${esc(t.body)}</p></div>
        <button type="button" data-act="spoiler" style="min-height:34px;padding:0 12px;border-radius:8px;border:1px solid ${t.spoiler ? 'rgba(176,72,60,.4)' : 'rgba(30,122,87,.4)'};background:${t.spoiler ? '#F4E3DE' : '#E7F0E6'};color:${t.spoiler ? '#B0483C' : '#1E7A57'};cursor:pointer;font-size:11px;font-weight:600">${t.spoiler ? 'SPOILER' : 'AMAN'}</button>
        <button type="button" data-act="del" style="min-height:34px;padding:0 12px;border-radius:8px;border:1.5px solid #B0483C;background:none;color:#B0483C;cursor:pointer;font-size:12px;font-weight:600">Hapus</button>
      </div>`,
      )
      .join('');

    document.getElementById('uni-loc')!.innerHTML = u.locations
      .map(
        (l, i) => `<div data-i="${i}" style="display:flex;gap:10px;align-items:center;border-bottom:1px solid rgba(122,51,65,.08);padding-bottom:8px;flex-wrap:wrap">
        <div style="flex:1"><p style="margin:0;font-weight:600">${esc(l.name)}</p><p style="margin:2px 0 0;font-size:12px;color:#9A8078">${esc(l.blurb)}</p></div>
        <button type="button" data-act="del" style="min-height:34px;padding:0 12px;border-radius:8px;border:1.5px solid #B0483C;background:none;color:#B0483C;cursor:pointer;font-size:12px;font-weight:600">Hapus</button>
      </div>`,
      )
      .join('');

    document.getElementById('uni-tr')!.innerHTML = u.trivia
      .map(
        (t, i) => `<div data-i="${i}" style="border-bottom:1px solid rgba(122,51,65,.08);padding-bottom:8px">
        <p style="margin:0;font-size:13px;font-weight:600;color:#7A3341">Q: ${esc(t.q)}</p>
        <p style="margin:4px 0 8px;font-size:13px;color:#5A453F">${esc(t.a)}</p>
        <button type="button" data-act="del" style="min-height:32px;padding:0 12px;border-radius:8px;border:1.5px solid #B0483C;background:none;color:#B0483C;cursor:pointer;font-size:12px;font-weight:600">Hapus</button>
      </div>`,
      )
      .join('');

    // binds
    document.querySelectorAll('#uni-chars [data-i]').forEach((row) => {
      const i = Number((row as HTMLElement).dataset.i);
      row.querySelector('[data-act="edit"]')?.addEventListener('click', () => {
        const u = get()!;
        const ch = u.characters[i];
        const name = prompt('Nama tokoh', ch.name);
        if (!name) return;
        const role = prompt('Peran', ch.role) || ch.role;
        const quote = prompt('Kutipan', ch.quote) || ch.quote;
        const bio = prompt('Bio singkat', ch.bio) || ch.bio;
        u.characters[i] = { ...ch, name, role, quote, bio, slug: name.toLowerCase().replace(/\s+/g, '-') };
        persist(u);
      });
      row.querySelector('[data-act="del"]')?.addEventListener('click', () => {
        if (!confirm('Hapus tokoh?')) return;
        const u = get()!;
        u.characters = u.characters.filter((_, idx) => idx !== i);
        persist(u);
      });
    });
    document.querySelectorAll('#uni-tl [data-i]').forEach((row) => {
      const i = Number((row as HTMLElement).dataset.i);
      row.querySelector('[data-act="spoiler"]')?.addEventListener('click', () => {
        const u = get()!;
        u.storyTimeline[i] = { ...u.storyTimeline[i], spoiler: !u.storyTimeline[i].spoiler };
        persist(u);
      });
      row.querySelector('[data-act="del"]')?.addEventListener('click', () => {
        if (!confirm('Hapus entri?')) return;
        const u = get()!;
        u.storyTimeline = u.storyTimeline.filter((_, idx) => idx !== i);
        persist(u);
      });
    });
    document.querySelectorAll('#uni-loc [data-i]').forEach((row) => {
      const i = Number((row as HTMLElement).dataset.i);
      row.querySelector('[data-act="del"]')?.addEventListener('click', () => {
        if (!confirm('Hapus lokasi?')) return;
        const u = get()!;
        u.locations = u.locations.filter((_, idx) => idx !== i);
        persist(u);
      });
    });
    document.querySelectorAll('#uni-tr [data-i]').forEach((row) => {
      const i = Number((row as HTMLElement).dataset.i);
      row.querySelector('[data-act="del"]')?.addEventListener('click', () => {
        if (!confirm('Hapus trivia?')) return;
        const u = get()!;
        u.trivia = u.trivia.filter((_, idx) => idx !== i);
        persist(u);
      });
    });
  }

  document.getElementById('uni-save-meta')?.addEventListener('click', () => {
    const u = get();
    if (!u) return;
    u.name = (document.getElementById('uni-name') as HTMLInputElement).value.trim() || u.name;
    u.blurb = (document.getElementById('uni-blurb') as HTMLTextAreaElement).value.trim() || u.blurb;
    persist(u);
  });
  document.getElementById('uni-add-char')?.addEventListener('click', () => {
    const u = get();
    if (!u) return;
    const name = prompt('Nama tokoh baru');
    if (!name) return;
    u.characters.push({
      slug: name.toLowerCase().replace(/\s+/g, '-'),
      name,
      role: prompt('Peran', 'Tokoh') || 'Tokoh',
      quote: prompt('Kutipan', '—') || '—',
      bio: prompt('Bio', '—') || '—',
      relations: [],
    });
    persist(u);
  });
  document.getElementById('uni-add-tl')?.addEventListener('click', () => {
    const u = get();
    if (!u) return;
    const title = prompt('Judul entri linimasa');
    if (!title) return;
    u.storyTimeline.push({
      id: `st${Date.now()}`,
      title,
      body: prompt('Isi singkat', '—') || '—',
      spoiler: confirm('Tandai sebagai spoiler?'),
    });
    persist(u);
  });
  document.getElementById('uni-add-loc')?.addEventListener('click', () => {
    const u = get();
    if (!u) return;
    const name = prompt('Nama lokasi');
    if (!name) return;
    u.locations.push({ id: `loc${Date.now()}`, name, blurb: prompt('Deskripsi', '—') || '—' });
    persist(u);
  });
  document.getElementById('uni-add-tr')?.addEventListener('click', () => {
    const u = get();
    if (!u) return;
    const q = prompt('Pertanyaan trivia');
    if (!q) return;
    u.trivia.push({ q, a: prompt('Jawaban', '—') || '—' });
    persist(u);
  });

  render();
</script>
