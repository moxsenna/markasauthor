---
import authorData from '../../data/author.json';
import type { AuthorData } from '../../lib/types';

const author = authorData as AuthorData;
---

<div
  id="telegram-mock-root"
  style="display:flex;justify-content:center;align-items:flex-start;padding:40px 16px 60px"
>
  <!-- Phone Frame -->
  <div
    style="width:100%;max-width:420px;background:#0F1A1C;border-radius:28px;overflow:hidden;box-shadow:0 12px 48px rgba(0,0,0,.28);border:2px solid #1C2E32"
  >
    <!-- Status strip -->
    <div
      style="text-align:center;padding:6px 12px;background:#0A1517;border-bottom:1px solid rgba(255,255,255,.05);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#8AA0A4;font-family:Lora,Georgia,serif"
    >
      Simulasi
    </div>

    <!-- Header Bar -->
    <div
      style="display:flex;align-items:center;gap:10px;padding:14px 18px;background:#1C2E32;border-bottom:1px solid rgba(255,255,255,.06)"
    >
      <div
        style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#7A3341,#5C2430);flex:none;display:flex;align-items:center;justify-content:center;font-size:18px;color:#F4E3DE"
      >
        &#9993;
      </div>
      <div style="min-width:0">
        <p
          style="margin:0;font-size:15px;font-weight:600;color:#FBF6EF;font-family:'Playfair Display',Georgia,serif;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"
        >
          MarkasAuthor Assistant
        </p>
        <p style="margin:0;font-size:11px;color:#8AA0A4;font-style:italic">
          online · simulasi
        </p>
      </div>
    </div>

    <!-- Step hint -->
    <div
      id="tg-step-hint"
      style="padding:8px 16px;background:#0F1A1C;border-bottom:1px solid rgba(255,255,255,.05);font-size:12px;color:#8AA0A4;font-family:Lora,Georgia,serif"
    >
      Menu utama · pilih aksi di bawah
    </div>

    <!-- Chat Area -->
    <div
      id="tg-chat"
      style="display:flex;flex-direction:column;gap:10px;padding:18px 14px;height:520px;overflow-y:auto;background:#0A1517"
    >
      <!-- Initial bot greeting -->
      <div style="align-self:flex-start;max-width:85%">
        <div
          style="background:#1C2E32;color:#DDE4E6;border-radius:16px 16px 16px 4px;padding:12px 16px;font-family:Lora,Georgia,serif;font-size:14px;line-height:1.7"
        >
          Halo, <strong style="color:#E8C4C8">{author.penName}</strong>! &#128075;<br />
          Ini simulasi notifikasi Telegram untuk Homebase Studio. Pilih menu di bawah atau ketik
          <code style="color:#E8C4C8">/start</code>.
        </div>
      </div>
    </div>

    <!-- Composer -->
    <div
      id="tg-composer"
      style="display:flex;align-items:center;gap:8px;padding:10px 12px;background:#1C2E32;border-top:1px solid rgba(255,255,255,.06)"
    >
      <input
        id="tg-composer-input"
        type="text"
        placeholder="Ketik /start atau pilih menu…"
        autocomplete="off"
        style="flex:1;height:40px;padding:0 14px;border-radius:20px;border:1px solid rgba(255,255,255,.1);background:#0A1517;color:#FBF6EF;font-family:Lora,Georgia,serif;font-size:13px;outline:none;box-sizing:border-box"
      />
      <button
        id="tg-composer-send"
        type="button"
        aria-label="Kirim"
        style="width:40px;height:40px;border-radius:50%;border:none;background:#7A3341;color:#FBF6EF;font-size:16px;cursor:pointer;flex:none;display:flex;align-items:center;justify-content:center"
      >
        &#10148;
      </button>
    </div>
  </div>
</div>

<script type="application/json" id="tg-author-data" set:html={JSON.stringify(author)} />

<script>
  import {
    createContext,
    clearActiveControls,
    setStepHint,
    appendUserBubble,
    botReply,
    appendKeyboard,
    appendTextControls,
    parseCommand,
  } from '../../lib/telegram-sim';
  import {
    publishChapter,
    buildWaMessage,
    loadContent,
    toggleBonusPublished,
    setWorkStatus,
    addUniverseTrivia,
  } from '../../lib/demo-store';
  import type { AuthorData, LatestChapter, Work } from '../../lib/types';

  const author = JSON.parse(
    document.getElementById('tg-author-data')!.textContent || '{}',
  ) as AuthorData;
  const chat = document.getElementById('tg-chat')!;
  const stepHint = document.getElementById('tg-step-hint');
  const composer = document.getElementById('tg-composer-input') as HTMLInputElement;
  const sendBtn = document.getElementById('tg-composer-send');

  let ctx = createContext();
  const TIER = 'hero';

  function resetIdle(showMenu = true) {
    clearActiveControls(chat);
    ctx = createContext();
    setStepHint(stepHint, 'Menu utama · pilih aksi di bawah');
    if (showMenu) renderMainMenu();
  }

  function renderMainMenu() {
    clearActiveControls(chat);
    appendKeyboard(
      chat,
      [
        { label: '✎ Update Bab', value: 'update' },
        { label: '📊 Status', value: 'status' },
        { label: '🎁 Bonus', value: 'bonus' },
        { label: '📚 Karya', value: 'karya' },
        { label: '🌌 Semesta', value: 'semesta' },
        { label: '☰ Lainnya', value: 'lainnya' },
      ],
      (value, label) => {
        appendUserBubble(chat, label);
        startFlow(value);
      },
      2,
    );
  }

  async function startFlow(flow: string) {
    clearActiveControls(chat);
    ctx = { phase: 'flow', flow, step: 0, draft: {} };
    if (flow === 'update') return flowUpdate();
    if (flow === 'status') return flowStatus();
    if (flow === 'bonus') return flowBonus();
    if (flow === 'karya') return flowKarya();
    if (flow === 'semesta') return flowSemesta();
    if (flow === 'riwayat') return flowRiwayat();
    if (flow === 'bantuan') return flowBantuan();
    if (flow === 'lainnya') return flowLainnya();
    await botReply(chat, 'Aksi belum tersedia.');
    resetIdle();
  }

  async function flowBonus() {
    setStepHint(stepHint, 'Bonus · pilih item');
    const state = loadContent(TIER, author);
    const bonuses = state.bonuses || [];

    if (!bonuses.length) {
      await botReply(chat, 'Belum ada bonus di demo ini.');
      appendKeyboard(
        chat,
        [{ label: 'Kembali ke Menu', value: 'menu' }],
        () => {
          appendUserBubble(chat, 'Kembali ke Menu');
          resetIdle(true);
        },
        1,
      );
      return;
    }

    await botReply(chat, 'Bonus mana yang diubah status publikasinya?');
    appendKeyboard(
      chat,
      bonuses.map((b) => ({
        label: `${b.title} · ${b.published ? 'PUBLIK' : 'DRAFT'}`,
        value: b.id,
      })),
      async (id, label) => {
        clearActiveControls(chat);
        appendUserBubble(chat, label);
        const bonus = bonuses.find((x) => x.id === id);
        if (!bonus) return;

        setStepHint(stepHint, 'Bonus · ubah status');
        const toggleLabel = bonus.published ? 'Sembunyikan' : 'Tampilkan';
        await botReply(
          chat,
          `<strong>${bonus.title}</strong><br/>Status: <span style="color:#E8C4C8">${bonus.published ? 'PUBLIK' : 'DRAFT'}</span>`,
        );
        appendKeyboard(
          chat,
          [
            { label: toggleLabel, value: 'toggle', style: 'primary' },
            { label: 'Kembali', value: 'back' },
          ],
          async (value, btnLabel) => {
            clearActiveControls(chat);
            appendUserBubble(chat, btnLabel);
            if (value === 'back') {
              resetIdle(true);
              return;
            }
            const next = toggleBonusPublished(TIER, id, author);
            const updated = (next.bonuses || []).find((x) => x.id === id);
            const stateLabel = updated?.published ? 'PUBLIK' : 'DRAFT';
            await botReply(
              chat,
              `✓ <strong>${bonus.title}</strong> sekarang <span style="color:#E8C4C8">${stateLabel}</span>.`,
            );
            resetIdle(true);
          },
          1,
        );
      },
      1,
    );
  }

  async function flowKarya() {
    setStepHint(stepHint, 'Karya · pilih status');
    const state = loadContent(TIER, author);
    const works: Work[] = state.works?.length ? state.works : author.works || [];

    if (!works.length) {
      await botReply(chat, 'Belum ada karya di demo ini.');
      appendKeyboard(
        chat,
        [{ label: 'Kembali ke Menu', value: 'menu' }],
        () => {
          appendUserBubble(chat, 'Kembali ke Menu');
          resetIdle(true);
        },
        1,
      );
      return;
    }

    await botReply(chat, 'Karya mana yang diubah statusnya?');
    appendKeyboard(
      chat,
      works.map((w) => ({
        label: `${w.title} · ${w.status}`,
        value: w.slug,
      })),
      async (slug, label) => {
        clearActiveControls(chat);
        appendUserBubble(chat, label);
        const work = works.find((x) => x.slug === slug);
        if (!work) return;

        setStepHint(stepHint, 'Karya · set status');
        await botReply(
          chat,
          `<strong>${work.title}</strong><br/>Status: <span style="color:#E8C4C8">${work.status}</span>`,
        );
        appendKeyboard(
          chat,
          [
            { label: 'TAYANG', value: 'TAYANG', style: 'primary' },
            { label: 'TAMAT', value: 'TAMAT' },
            { label: 'Kembali', value: 'back' },
          ],
          async (value, btnLabel) => {
            clearActiveControls(chat);
            appendUserBubble(chat, btnLabel);
            if (value === 'back') {
              resetIdle(true);
              return;
            }
            if (value !== 'TAYANG' && value !== 'TAMAT') return;
            setWorkStatus(TIER, slug, value, author);
            await botReply(
              chat,
              `✓ <strong>${work.title}</strong> status <span style="color:#E8C4C8">${value}</span>.`,
            );
            resetIdle(true);
          },
          1,
        );
      },
      1,
    );
  }

  async function flowSemesta() {
    setStepHint(stepHint, 'Semesta · tambah trivia');
    await botReply(
      chat,
      'Mini-alur Semesta: <strong style="color:#E8C4C8">tambah trivia Q&amp;A</strong> ke semesta demo.<br/><span style="font-size:12px;color:#8AA0A4">Hanya tambah — edit/hapus lewat Dashboard.</span>',
    );
    await botReply(
      chat,
      'Pertanyaan trivia?<br/><span style="font-size:12px;color:#8AA0A4">Misal: <em>Apa nama semesta ini?</em></span>',
    );
    appendTextControls(chat, {
      placeholder: 'Pertanyaan…',
      sample: 'Apa nama semesta ini?',
      onSubmit: async (q) => {
        appendUserBubble(chat, q);
        ctx.draft.triviaQ = q;
        setStepHint(stepHint, 'Semesta · jawaban trivia');
        await botReply(
          chat,
          'Jawaban trivia?<br/><span style="font-size:12px;color:#8AA0A4">Satu–dua kalimat singkat</span>',
        );
        appendTextControls(chat, {
          placeholder: 'Jawaban…',
          sample: 'Semesta di bawah langit berkarat.',
          onSubmit: async (a) => {
            appendUserBubble(chat, a);
            ctx.draft.triviaA = a;
            setStepHint(stepHint, 'Semesta · pratinjau');
            clearActiveControls(chat);
            await botReply(
              chat,
              `<strong>Pratinjau Trivia</strong><br/><br/>
              <strong>Q:</strong> ${ctx.draft.triviaQ}<br/>
              <strong>A:</strong> ${a}<br/><br/>
              <span style="font-size:12px;color:#8AA0A4">Simpan ke semesta demo?</span>`,
            );
            appendKeyboard(
              chat,
              [
                { label: '✓ Simpan', value: 'save', style: 'primary' },
                { label: '✗ Batalkan', value: 'cancel', style: 'danger' },
              ],
              async (value) => {
                clearActiveControls(chat);
                if (value === 'cancel') {
                  await botReply(chat, 'Dibatalkan.');
                  resetIdle(true);
                  return;
                }
                addUniverseTrivia(
                  TIER,
                  { q: String(ctx.draft.triviaQ || ''), a: String(a) },
                  author,
                );
                await botReply(
                  chat,
                  '✓ Trivia tersimpan di semesta demo.',
                );
                resetIdle(true);
              },
              2,
            );
          },
        });
      },
    });
  }

  async function flowUpdate() {
    setStepHint(stepHint, 'Update bab · 1/4 Karya');
    const state = loadContent(TIER, author);
    const works: Work[] = state.works?.length ? state.works : author.works || [];

    if (!works.length) {
      await botReply(chat, 'Belum ada karya di demo ini.');
      resetIdle(true);
      return;
    }

    await botReply(chat, 'Karya mana yang akan di-update?');
    appendKeyboard(
      chat,
      works.map((w) => ({
        label: `${w.title} (${w.status})`,
        value: w.slug,
      })),
      async (slug, label) => {
        const w = works.find((x) => x.slug === slug);
        if (!w) return;
        appendUserBubble(chat, label);
        ctx.draft.workSlug = w.slug;
        ctx.draft.workTitle = w.title;
        ctx.draft.kbmUrl = w.kbmUrl;
        ctx.step = 2;
        setStepHint(stepHint, 'Update bab · 2/4 Judul');
        await botReply(
          chat,
          'Judul bab barunya apa?<br/><span style="font-size:12px;color:#8AA0A4">Misal: <em>Bab 48 — Pintu yang Terbuka</em></span>',
        );
        appendTextControls(chat, {
          placeholder: 'Bab 48 — …',
          sample: 'Bab 48 — Pintu yang Terbuka',
          onSubmit: async (title) => {
            appendUserBubble(chat, title);
            ctx.draft.title = title;
            ctx.step = 3;
            setStepHint(stepHint, 'Update bab · 3/4 Teaser');
            await botReply(
              chat,
              'Teaser satu kalimat?<br/><span style="font-size:12px;color:#8AA0A4">Opsional — tanpa isi cerita, bisa dilewati</span>',
            );
            appendTextControls(chat, {
              placeholder: 'Satu kalimat penggoda…',
              sample: 'Satu kalimat penggoda…',
              allowSkip: true,
              onSubmit: async (teaser) => {
                appendUserBubble(chat, teaser);
                ctx.draft.teaser = teaser;
                await showPublishPreview();
              },
              onSkip: async () => {
                ctx.draft.teaser = '';
                await showPublishPreview();
              },
            });
          },
        });
      },
      1,
    );
  }

  async function showPublishPreview() {
    ctx.step = 4;
    setStepHint(stepHint, 'Update bab · 4/4 Pratinjau');
    clearActiveControls(chat);

    let previewHtml = `<strong>Pratinjau Bab Baru</strong><br/><br/>
      <strong>Karya:</strong> ${ctx.draft.workTitle}<br/>
      <strong>Judul:</strong> ${ctx.draft.title}`;

    if (ctx.draft.teaser) {
      previewHtml += `<br/><strong>Teaser:</strong> <em>"${ctx.draft.teaser}"</em>`;
    }

    previewHtml +=
      '<br/><br/><span style="font-size:12px;color:#8AA0A4">Apakah sudah benar?</span>';

    await botReply(chat, previewHtml);
    appendKeyboard(
      chat,
      [
        { label: '✓ Publikasikan', value: 'publish', style: 'primary' },
        { label: '✗ Batalkan', value: 'cancel', style: 'danger' },
      ],
      async (value) => {
        if (value === 'cancel') {
          clearActiveControls(chat);
          await botReply(chat, 'Dibatalkan.');
          resetIdle(true);
          return;
        }

        const chapter: LatestChapter = {
          workSlug: ctx.draft.workSlug,
          workTitle: ctx.draft.workTitle,
          title: ctx.draft.title,
          date: new Date().toLocaleDateString('id-ID', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
          }),
          kbmUrl: ctx.draft.kbmUrl,
          teaser: ctx.draft.teaser || undefined,
        };

        publishChapter(TIER, chapter, author.latestChapters || []);
        clearActiveControls(chat);
        showWaPreview(chapter);
      },
      2,
    );
  }

  function showWaPreview(chapter: LatestChapter) {
    setStepHint(stepHint, 'Update bab · tersimpan');
    const msg = buildWaMessage(chapter);

    const wrap = document.createElement('div');
    wrap.className = 'tg-active-controls';
    wrap.style.cssText =
      'align-self:flex-start;max-width:85%;display:flex;flex-direction:column;gap:8px';

    const ok = document.createElement('div');
    ok.style.cssText =
      'background:#1C2E32;color:#7CC9A4;border-radius:16px 16px 16px 4px;padding:10px 16px;font-family:Lora,Georgia,serif;font-size:13px';
    ok.innerHTML = '&#10003; Bab tersimpan! Berikut pesan siap-tempel:';
    wrap.appendChild(ok);

    const draft = document.createElement('div');
    draft.style.cssText =
      'background:#0D2A1E;border:1px solid rgba(30,122,87,.25);border-radius:14px;padding:12px 16px;font-family:Lora,Georgia,serif;font-size:12.5px;line-height:1.7;color:#DDE4E6;white-space:pre-wrap';
    draft.textContent = msg;
    wrap.appendChild(draft);

    const btnRow = document.createElement('div');
    btnRow.style.cssText = 'display:flex;gap:8px;flex-wrap:wrap';

    const copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.textContent = 'Salin Pesan WA';
    copyBtn.style.cssText =
      'height:36px;padding:0 18px;background:#1E7A57;color:#FBF6EF;border:none;border-radius:18px;font-family:Lora,Georgia,serif;font-size:13px;font-weight:600;cursor:pointer';
    copyBtn.addEventListener('click', () => {
      try {
        navigator.clipboard.writeText(msg);
      } catch {
        /* ignore */
      }
      copyBtn.textContent = '✓ Tersalin';
      copyBtn.style.background = '#3E8A60';
      setTimeout(() => {
        copyBtn.textContent = 'Salin Pesan WA';
        copyBtn.style.background = '#1E7A57';
      }, 2000);
    });

    const backBtn = document.createElement('button');
    backBtn.type = 'button';
    backBtn.textContent = 'Kembali';
    backBtn.style.cssText =
      'height:36px;padding:0 18px;background:transparent;color:#8AA0A4;border:1px solid rgba(255,255,255,.08);border-radius:18px;font-family:Lora,Georgia,serif;font-size:13px;cursor:pointer';
    backBtn.addEventListener('click', () => {
      clearActiveControls(chat);
      resetIdle(true);
    });

    btnRow.appendChild(copyBtn);
    btnRow.appendChild(backBtn);
    wrap.appendChild(btnRow);
    chat.appendChild(wrap);
    chat.scrollTop = chat.scrollHeight;
  }

  async function flowStatus() {
    setStepHint(stepHint, 'Status · ringkasan demo');
    const state = loadContent(TIER, author);
    const latest = state.latestChapters?.[0];
    const html = `<strong>Status Homebase</strong><br/><br/>
    <strong>Karya:</strong> ${state.works?.length ?? 0}<br/>
    <strong>Riwayat rilis:</strong> ${state.history?.length ?? 0}<br/>
    <strong>Bab terbaru:</strong> ${
      latest
        ? `${latest.workTitle} — ${latest.title} <span style="color:#8AA0A4">(${latest.date})</span>`
        : '<em style="color:#8AA0A4">belum ada</em>'
    }`;
    await botReply(chat, html);
    appendKeyboard(
      chat,
      [
        { label: 'Buka Dashboard', value: 'dash', style: 'primary' },
        { label: 'Kembali ke Menu', value: 'menu' },
      ],
      (value) => {
        if (value === 'dash') {
          window.location.href = '/dashboard';
          return;
        }
        appendUserBubble(chat, 'Kembali ke Menu');
        resetIdle(true);
      },
      1,
    );
  }

  async function flowLainnya() {
    setStepHint(stepHint, 'Lainnya · pilih opsi');
    await botReply(chat, 'Menu lainnya:');
    appendKeyboard(
      chat,
      [
        { label: '📄 Riwayat', value: 'riwayat' },
        { label: '❓ Bantuan', value: 'bantuan' },
        { label: '↻ Mulai ulang', value: 'start' },
        { label: '← Kembali', value: 'menu' },
      ],
      async (value, label) => {
        appendUserBubble(chat, label);
        if (value === 'start') {
          await botReply(
            chat,
            `Halo lagi, <strong style="color:#E8C4C8">${author.penName}</strong>! Siap coba simulasi.`,
          );
          resetIdle(true);
          return;
        }
        if (value === 'menu') {
          resetIdle(true);
          return;
        }
        startFlow(value);
      },
      2,
    );
  }

  async function flowBantuan() {
    setStepHint(stepHint, 'Bantuan · cara pakai simulasi');
    await botReply(
      chat,
      `<strong>Tentang Simulasi Ini</strong><br/><br/>
      Start-up ini mendemonstrasikan <strong style="color:#E8C4C8">dual-surface</strong> manajemen penulis:<br/><br/>
      <strong>• Dashboard</strong> — kontrol penuh via /dashboard (desktop)<br/>
      <strong>• Telegram</strong> — notifikasi & aksi cepat dari HP<br/><br/>
      Semua data demo disimpan di <em>localStorage</em> browser Anda (bukan bot asli).<br/><br/>
      <strong>Perintah:</strong><br/>
      <code style="color:#E8C4C8">/start</code> · menu utama<br/>
      <code style="color:#E8C4C8">/update</code> · update bab<br/>
      <code style="color:#E8C4C8">/status</code> · ringkasan<br/>
      <code style="color:#E8C4C8">/riwayat</code> · rilis terbaru<br/>
      <code style="color:#E8C4C8">/bantuan</code> · bantuan ini<br/>
      <code style="color:#E8C4C8">/batal</code> · batalkan alur aktif`,
    );
    appendKeyboard(
      chat,
      [{ label: 'Kembali ke Menu', value: 'menu' }],
      () => {
        appendUserBubble(chat, 'Kembali ke Menu');
        resetIdle(true);
      },
      1,
    );
  }

  async function flowRiwayat() {
    setStepHint(stepHint, 'Riwayat · rilis demo');
    const state = loadContent(TIER, author);
    const history =
      state.history?.filter((c) => c.workSlug && c.title).slice(0, 10) ?? [];

    let html = '<strong>Riwayat Rilis</strong><br/><br/>';
    if (history.length === 0) {
      html +=
        '<span style="color:#8AA0A4;font-style:italic">Belum ada rilis dari simulasi ini.</span>';
    } else {
      history.forEach((r) => {
        html += `<div style="margin-bottom:7px;padding-bottom:7px;border-bottom:1px solid rgba(255,255,255,.06)">
          <span style="color:#E8C4C8;font-weight:600">${r.workTitle}</span> — ${r.title}<br/>
          <span style="font-size:11px;color:#8AA0A4">${r.date}</span>
        </div>`;
      });
    }

    await botReply(chat, html);
    appendKeyboard(
      chat,
      [{ label: 'Kembali ke Menu', value: 'menu' }],
      () => {
        appendUserBubble(chat, 'Kembali ke Menu');
        resetIdle(true);
      },
      1,
    );
  }

  async function handleComposerSend() {
    const val = composer.value.trim();
    composer.value = '';
    if (!val) return;

    const cmd = parseCommand(val);

    if (cmd === '/batal') {
      clearActiveControls(chat);
      appendUserBubble(chat, val);
      await botReply(chat, 'Dibatalkan.');
      resetIdle(true);
      return;
    }

    if (ctx.phase === 'idle') {
      appendUserBubble(chat, val);
      if (cmd === '/start') {
        await botReply(
          chat,
          `Halo, <strong style="color:#E8C4C8">${author.penName}</strong>! Pilih aksi di menu.`,
        );
        resetIdle(true);
        return;
      }
      if (cmd === '/update') return startFlow('update');
      if (cmd === '/status') return startFlow('status');
      if (cmd === '/riwayat') return startFlow('riwayat');
      if (cmd === '/bantuan') return startFlow('bantuan');
      if (cmd) {
        await botReply(
          chat,
          'Perintah tidak dikenal. Coba <code style="color:#E8C4C8">/start</code>, <code style="color:#E8C4C8">/update</code>, <code style="color:#E8C4C8">/status</code>, <code style="color:#E8C4C8">/riwayat</code>, <code style="color:#E8C4C8">/bantuan</code>.',
        );
        return;
      }
      await botReply(chat, 'Pilih menu atau ketik /start');
      return;
    }

    // In flow: free text ignored (controls own input); non-batal commands tip only
    if (cmd) {
      appendUserBubble(chat, val);
      await botReply(chat, 'Gunakan tombol di chat, atau /batal');
      return;
    }
    appendUserBubble(chat, val);
    await botReply(chat, 'Gunakan tombol di chat, atau /batal');
  }

  sendBtn?.addEventListener('click', () => {
    void handleComposerSend();
  });
  composer?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      void handleComposerSend();
    }
  });

  document.querySelectorAll('[data-tg-guide]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.getAttribute('data-tg-guide');
      if (!f) return;
      clearActiveControls(chat);
      appendUserBubble(chat, (btn.textContent || f).trim());
      startFlow(f);
    });
  });

  setStepHint(stepHint, 'Menu utama · pilih aksi di bawah');
  renderMainMenu();
</script>
