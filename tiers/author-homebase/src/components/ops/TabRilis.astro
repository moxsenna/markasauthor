---
import type { Work, LatestChapter } from '../../lib/types';

export interface Props {
  works: Work[];
  fallbackChapters: LatestChapter[];
  tier?: string;
}

const { works, fallbackChapters, tier = 'hero' } = Astro.props;
const fallbackJson = JSON.stringify(fallbackChapters);
const worksJson = JSON.stringify(works);
---

<div class="ops-rilis" data-tier={tier}>
  <header class="ops-rilis-head">
    <h1>Kabar Rilis</h1>
    <p>
      Tulis pengumuman bab baru — kartu “Baru Terbit” di Beranda ikut diperbarui, dan pesan siap
      tempel untuk Saluran WhatsApp dibuat otomatis. Tanpa isi cerita, hanya kabar.
    </p>
  </header>

  <div class="ops-rilis-grid">
    <section class="ops-card ops-rilis-form">
      <div class="ops-field">
        <label for="rilis-karya">Karya</label>
        <select id="rilis-karya">
          {
            works.map((w) => (
              <option value={w.slug} data-kbm-url={w.kbmUrl}>
                {w.title}
              </option>
            ))
          }
        </select>
      </div>

      <div class="ops-field">
        <label for="rilis-judul">Judul bab</label>
        <input type="text" id="rilis-judul" placeholder="Bab 48 — …" />
      </div>

      <div class="ops-field">
        <label for="rilis-teaser">
          Teaser satu kalimat
          <span class="ops-hint">— tanpa isi cerita, max 140 karakter</span>
        </label>
        <textarea id="rilis-teaser" rows="3" placeholder="Satu kalimat penggoda, tanpa bocoran…"
        ></textarea>
        <p id="teaser-count" class="ops-meta">0/140 karakter</p>
      </div>

      <div class="ops-actions">
        <button type="button" id="btn-terbitkan" class="ops-btn-primary">
          Publikasikan (simulasi)
        </button>
        <span id="rilis-sukses" class="ops-ok" hidden>✓ Bab disimpan ke penyimpanan lokal</span>
        <span id="rilis-error" class="ops-err" hidden>Judul bab wajib diisi.</span>
      </div>
    </section>

    <aside class="ops-rilis-side">
      <section class="ops-card ops-wa">
        <p class="ops-eyebrow ops-eyebrow-wa">PESAN SIAP TEMPEL — SALURAN WA</p>
        <div id="wa-draft" class="ops-wa-box">
          <p id="wa-text">Isi judul bab dan teaser. Pesan WA akan muncul di sini.</p>
        </div>
        <button type="button" id="btn-salin" class="ops-btn-wa">Salin Pesan</button>
        <p class="ops-meta ops-meta-wa">
          Tempel di Saluran WhatsApp-mu — 3 ketukan dari HP, semua pengikut langsung tahu.
        </p>
      </section>

      <section class="ops-card">
        <p class="ops-eyebrow">RIWAYAT RILIS</p>
        <div id="riwayat-list">
          <p class="ops-empty">Belum ada rilis dari dashboard ini.</p>
        </div>
      </section>
    </aside>
  </div>
</div>

<script type="application/json" id="fallback-chapters" set:html={fallbackJson} />
<script type="application/json" id="works-data" set:html={worksJson} />

<style>
  .ops-rilis {
    max-width: 1100px;
  }
  .ops-rilis-head h1 {
    margin: 0 0 6px;
    font-family: 'Playfair Display', serif;
    font-size: clamp(26px, 4vw, 32px);
    font-weight: 600;
    color: #3b2a28;
    line-height: 1.2;
  }
  .ops-rilis-head p {
    margin: 0 0 26px;
    max-width: 620px;
    font-size: 14px;
    line-height: 1.6;
    color: #7a5a50;
  }
  .ops-rilis-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
    gap: 24px;
    align-items: start;
  }
  .ops-rilis-side {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .ops-card {
    background: #fbf6ef;
    border: 1px solid rgba(122, 51, 65, 0.14);
    border-radius: 18px;
    padding: 22px;
    box-sizing: border-box;
    min-width: 0;
  }
  .ops-rilis-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 26px 28px;
  }
  .ops-field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #5a453f;
    margin-bottom: 6px;
  }
  .ops-hint {
    font-weight: 400;
    color: #9a8078;
  }
  .ops-field input,
  .ops-field select,
  .ops-field textarea {
    width: 100%;
    box-sizing: border-box;
    border-radius: 11px;
    border: 1px solid rgba(122, 51, 65, 0.25);
    background: #fffdf9;
    color: #3b2a28;
    font-family: Lora, serif;
    font-size: 15px;
  }
  .ops-field input,
  .ops-field select {
    height: 48px;
    padding: 0 14px;
  }
  .ops-field textarea {
    padding: 12px 14px;
    line-height: 1.6;
    resize: vertical;
  }
  .ops-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .ops-btn-primary {
    height: 50px;
    padding: 0 24px;
    background: #7a3341;
    color: #fbf6ef;
    border: none;
    border-radius: 12px;
    font-family: Lora, serif;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .ops-btn-wa {
    margin-top: 12px;
    width: 100%;
    height: 46px;
    background: #1e7a57;
    color: #fbf6ef;
    border: none;
    border-radius: 11px;
    font-family: Lora, serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .ops-ok {
    font-size: 13px;
    color: #1e7a57;
  }
  .ops-err {
    font-size: 13px;
    color: #b0483c;
  }
  .ops-eyebrow {
    margin: 0 0 10px;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: #8a6a5e;
    font-weight: 600;
  }
  .ops-eyebrow-wa {
    color: #1e7a57;
  }
  .ops-wa {
    background: #e7f0e6;
    border-color: rgba(30, 122, 87, 0.2);
  }
  .ops-wa-box {
    background: #fffdf9;
    border-radius: 12px;
    padding: 14px 16px;
    border: 1px solid rgba(30, 122, 87, 0.15);
  }
  .ops-wa-box p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: #3b2a28;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .ops-meta {
    margin: 6px 0 0;
    font-size: 12px;
    color: #9a8078;
  }
  .ops-meta-wa {
    color: #5f7a64;
    line-height: 1.5;
  }
  .ops-empty {
    margin: 0;
    font-size: 13px;
    color: #9a8078;
    font-style: italic;
  }

  @media (max-width: 1024px) {
    .ops-rilis-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .ops-rilis-form {
      padding: 18px 16px;
    }
    .ops-card {
      padding: 16px;
    }
    .ops-btn-primary {
      width: 100%;
    }
  }
</style>

<script>
  import { publishChapter, buildWaMessage, loadDemoState } from '../../lib/demo-store';
  import type { LatestChapter, Work } from '../../lib/types';

  function safeJson<T>(el: Element | null, fallback: T): T {
    if (!el?.textContent) return fallback;
    try {
      return JSON.parse(el.textContent) as T;
    } catch {
      return fallback;
    }
  }

  const fallbackChapters = safeJson<LatestChapter[]>(
    document.getElementById('fallback-chapters'),
    [],
  );
  const works = safeJson<Work[]>(document.getElementById('works-data'), []);

  const selectKarya = document.getElementById('rilis-karya') as HTMLSelectElement | null;
  const inputJudul = document.getElementById('rilis-judul') as HTMLInputElement | null;
  const textareaTeaser = document.getElementById('rilis-teaser') as HTMLTextAreaElement | null;
  const teaserCount = document.getElementById('teaser-count');
  const waText = document.getElementById('wa-text');
  const btnTerbitkan = document.getElementById('btn-terbitkan');
  const btnSalin = document.getElementById('btn-salin');
  const rilisSukses = document.getElementById('rilis-sukses');
  const rilisError = document.getElementById('rilis-error');
  const riwayatList = document.getElementById('riwayat-list');

  if (!selectKarya || !inputJudul || !textareaTeaser || !btnTerbitkan) {
    /* panel not mounted */
  } else {
    const MAX_TEASER = 140;
    const appTier =
      (document.querySelector('.ops-rilis') as HTMLElement)?.dataset.tier || 'hero';

    function getSelectedWork(): Work | undefined {
      return works.find((w) => w.slug === selectKarya!.value);
    }

    function buildCurrentWa(): string {
      const w = getSelectedWork();
      return buildWaMessage({
        workSlug: w?.slug ?? '',
        workTitle: w?.title ?? '',
        title: inputJudul!.value || '[judul bab]',
        date: new Date().toLocaleDateString('id-ID', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        }),
        kbmUrl: w?.kbmUrl ?? '#',
        teaser: textareaTeaser!.value || undefined,
      });
    }

    function updateWaPreview() {
      if (waText) waText.textContent = buildCurrentWa();
      const len = textareaTeaser!.value.length;
      if (teaserCount) {
        teaserCount.textContent = `${len}/${MAX_TEASER} karakter`;
        teaserCount.style.color = len > MAX_TEASER ? '#B0483C' : '#9A8078';
      }
    }

    function renderHistory() {
      if (!riwayatList) return;
      const state = loadDemoState(appTier, fallbackChapters);
      const hist = state.history || [];
      if (!hist.length) {
        riwayatList.innerHTML = '<p class="ops-empty">Belum ada rilis dari dashboard ini.</p>';
        return;
      }
      riwayatList.innerHTML = hist
        .slice(0, 8)
        .map(
          (h) =>
            `<div style="padding:10px 0;border-bottom:1px solid rgba(122,51,65,.1)">
              <p style="margin:0;font-size:14px;font-weight:600;color:#3B2A28">${h.title}</p>
              <p style="margin:3px 0 0;font-size:12px;color:#9A8078">${h.workTitle} · ${h.date}</p>
            </div>`,
        )
        .join('');
    }

    selectKarya.addEventListener('change', updateWaPreview);
    inputJudul.addEventListener('input', updateWaPreview);
    textareaTeaser.addEventListener('input', updateWaPreview);

    btnTerbitkan.addEventListener('click', () => {
      const title = inputJudul.value.trim();
      if (!title) {
        rilisError?.removeAttribute('hidden');
        rilisSukses?.setAttribute('hidden', '');
        return;
      }
      if (textareaTeaser.value.length > MAX_TEASER) {
        rilisError!.textContent = 'Teaser max 140 karakter.';
        rilisError?.removeAttribute('hidden');
        return;
      }
      const w = getSelectedWork();
      const chapter: LatestChapter = {
        workSlug: w?.slug ?? '',
        workTitle: w?.title ?? '',
        title,
        date: new Date().toLocaleDateString('id-ID', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        }),
        kbmUrl: w?.kbmUrl ?? '#',
        teaser: textareaTeaser.value.trim() || undefined,
      };
      publishChapter(appTier, chapter, fallbackChapters);
      rilisError?.setAttribute('hidden', '');
      rilisSukses?.removeAttribute('hidden');
      updateWaPreview();
      renderHistory();
    });

    btnSalin?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(buildCurrentWa());
        btnSalin.textContent = '✓ Tersalin';
        setTimeout(() => {
          btnSalin.textContent = 'Salin Pesan';
        }, 1600);
      } catch {
        /* ignore */
      }
    });

    updateWaPreview();
    renderHistory();
  }
</script>
