---
import type { DemoReader } from '../../lib/types';

export interface Props {
  readers: DemoReader[];
}

const { readers } = Astro.props;
---

<div>
  <div
    style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px"
  >
    <div>
      <h1
        style="margin:0 0 6px;font-family:'Playfair Display',serif;font-size:32px;font-weight:600;color:#3B2A28"
      >
        Database Pembaca
      </h1>
      <p style="margin:0;font-size:14px;color:#7A5A50">
        {readers.length} kontak demo — simulasi, bukan data asli.
      </p>
    </div>
    <div style="display:flex;gap:10px;flex:none">
      <a
        href="#"
        style="display:flex;align-items:center;justify-content:center;height:48px;padding:0 20px;background:none;border:1.5px solid #7A3341;color:#7A3341;border-radius:12px;font-size:14px;font-weight:600;text-decoration:none"
      >
        Buka Google Sheet &rarr;
      </a>
    </div>
  </div>

  <!-- Quick Stats -->
  <div
    style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:22px"
  >
    <div
      style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:14px;padding:16px 20px"
    >
      <p style="margin:0;font-size:12px;color:#8A6A5E">Total kontak</p>
      <p
        style="margin:6px 0 0;font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:#5C2430"
      >
        {readers.length}
      </p>
    </div>
    <div
      style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:14px;padding:16px 20px"
    >
      <p style="margin:0;font-size:12px;color:#8A6A5E">Sumber terbesar</p>
      <p
        style="margin:6px 0 0;font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:#5C2430"
      >
        Beranda
      </p>
    </div>
    <div
      style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:14px;padding:16px 20px"
    >
      <p style="margin:0;font-size:12px;color:#8A6A5E">Data tersimpan</p>
      <p
        style="margin:6px 0 0;font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:#5C2430"
      >
        Google Sheet
      </p>
    </div>
  </div>

  <!-- Table -->
  <div
    style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;overflow:hidden"
  >
    <div class="ops-scroll-x" style="overflow-x:auto;-webkit-overflow-scrolling:touch">
    <div
      style="display:flex;align-items:center;gap:14px;padding:16px 22px;border-bottom:1px solid rgba(122,51,65,.12)"
    >
      <input
        type="text"
        id="db-cari"
        placeholder="Cari nama atau nomor…"
        style="flex:1;height:44px;padding:0 14px;border-radius:10px;border:1px solid rgba(122,51,65,.2);background:#FFFDF9;color:#3B2A28;font-family:Lora,serif;font-size:14px;box-sizing:border-box"
      />
      <span id="db-count" style="flex:none;font-size:13px;color:#9A8078">
        {readers.length} kontak
      </span>
    </div>
    <div
      style="display:grid;grid-template-columns:2fr 1.6fr 1.2fr 1fr;gap:0;padding:10px 22px;font-size:11px;letter-spacing:.1em;color:#8A6A5E;font-weight:600;border-bottom:1px solid rgba(122,51,65,.12)"
    >
      <span>NAMA</span><span>NOMOR WA</span><span>SUMBER</span><span>TANGGAL</span>
    </div>
    <div id="db-rows">
      {readers.map((r) => (
        <div
          style="display:grid;grid-template-columns:2fr 1.6fr 1.2fr 1fr;gap:0;padding:13px 22px;border-bottom:1px solid rgba(122,51,65,.08);font-size:14px;color:#3B2A28;align-items:center"
        >
          <span style="font-weight:600">{r.name}</span>
          <span style="color:#6A5248">{r.wa}</span>
          <span>
            <span
              style="font-size:11px;font-weight:600;color:#7A3341;background:#F4E3DE;border-radius:999px;padding:4px 10px"
            >
              {r.source}
            </span>
          </span>
          <span style="color:#9A8078;font-size:13px">{r.date}</span>
        </div>
      ))}
    </div>
    </div>
  </div>
</div>

<script type="application/json" id="readers-json">
  {JSON.stringify(readers)}
</script>

<script>
  import type { DemoReader } from '../../lib/types';

  const readersEl = document.getElementById('readers-json');
  const allReaders: DemoReader[] = readersEl
    ? JSON.parse(readersEl.textContent || '[]')
    : [];

  const inputCari = document.getElementById('db-cari') as HTMLInputElement;
  const dbCount = document.getElementById('db-count')!;
  const dbRows = document.getElementById('db-rows')!;

  function renderRows(q: string) {
    const filtered = q
      ? allReaders.filter(
          (r) =>
            r.name.toLowerCase().includes(q) || r.wa.includes(q),
        )
      : allReaders;
    dbCount.textContent = `${filtered.length} kontak`;
    dbRows.innerHTML = filtered
      .map(
        (r) =>
          `<div style="display:grid;grid-template-columns:2fr 1.6fr 1.2fr 1fr;gap:0;padding:13px 22px;border-bottom:1px solid rgba(122,51,65,.08);font-size:14px;color:#3B2A28;align-items:center">
            <span style="font-weight:600">${r.name}</span>
            <span style="color:#6A5248">${r.wa}</span>
            <span><span style="font-size:11px;font-weight:600;color:#7A3341;background:#F4E3DE;border-radius:999px;padding:4px 10px">${r.source}</span></span>
            <span style="color:#9A8078;font-size:13px">${r.date}</span>
          </div>`,
      )
      .join('');
  }

  inputCari.addEventListener('input', () => {
    renderRows(inputCari.value.trim().toLowerCase());
  });
</script>
