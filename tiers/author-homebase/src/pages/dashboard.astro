---
import OpsLayout from '../layouts/OpsLayout.astro';
import OpsNav from '../components/ops/OpsNav.astro';
import TabRingkasan from '../components/ops/TabRingkasan.astro';
import TabRilis from '../components/ops/TabRilis.astro';
import TabDatabase from '../components/ops/TabDatabase.astro';
import TabTema from '../components/ops/TabTema.astro';
import TabBonus from '../components/ops/TabBonus.astro';
import TabPeta from '../components/ops/TabPeta.astro';
import TabKarya from '../components/ops/TabKarya.astro';
import authorData from '../data/author.json';
import type { AuthorData } from '../lib/types';

const author = authorData as AuthorData;
const initialTab = (Astro.url.searchParams.get('tab') || 'ringkasan') as string;
---

<OpsLayout penName={author.penName} activeTab={initialTab}>
  <OpsNav slot="nav" activeTab={initialTab} />

  <div id="tab-content">
    {initialTab === 'ringkasan' && (
      <TabRingkasan penName={author.penName} tagline={author.tagline} />
    )}
    {initialTab === 'rilis' && (
      <TabRilis works={author.works} fallbackChapters={author.latestChapters} />
    )}
    {initialTab === 'database' && <TabDatabase readers={author.demoReaders} />}
    {initialTab === 'bonus' && <TabBonus bonuses={author.bonuses} />}
    {initialTab === 'peta' && (
      <TabPeta readingMain={author.readingMain} readingSide={author.readingSide} />
    )}
    {initialTab === 'karya' && <TabKarya works={author.works} />}
    {initialTab === 'tema' && <TabTema />}
    {initialTab === 'universe' && (
      <div style="text-align:center;padding:80px 20px">
        <h2 style="font-family:'Playfair Display',serif;font-size:24px;color:#3B2A28;margin-bottom:8px">
          Semesta — Signature
        </h2>
        <p style="color:#7A5A50;font-size:14px;max-width:420px;margin:0 auto 18px">
          Kelola tokoh, timeline, dan trivia universe di tier Signature Universe.
        </p>
        <a
          href="https://ma-signature-universe.pages.dev/dashboard?tab=universe"
          style="display:inline-flex;align-items:center;height:44px;padding:0 20px;background:#7A3341;color:#FBF6EF;border-radius:12px;font-size:14px;font-weight:600;text-decoration:none"
        >
          Lihat demo Signature →
        </a>
      </div>
    )}
    {!['ringkasan', 'rilis', 'database', 'bonus', 'peta', 'karya', 'tema', 'universe'].includes(
      initialTab,
    ) && (
      <div style="text-align:center;padding:80px 20px">
        <h2 style="font-family:'Playfair Display',serif;font-size:24px;color:#3B2A28;margin-bottom:8px">
          Tab tidak dikenal
        </h2>
        <p style="color:#7A5A50;font-size:14px">Pilih menu di sidebar kiri.</p>
      </div>
    )}
  </div>

  <script>
    function switchTab(tab: string) {
      const url = new URL(window.location.href);
      url.searchParams.set('tab', tab);
      window.location.href = url.toString();
    }

    document.querySelectorAll<HTMLButtonElement>('.ops-nav-btn').forEach((btn) => {
      const tab = btn.dataset.tab;
      const enabled = btn.dataset.enabled !== 'false';
      if (tab && enabled) {
        btn.addEventListener('click', () => switchTab(tab));
      }
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-go-tab]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const tab = a.dataset.goTab;
        if (tab) switchTab(tab);
      });
    });
  </script>
</OpsLayout>
