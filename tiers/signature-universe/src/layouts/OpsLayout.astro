---
import '../styles/global.css';

export interface Props {
  penName: string;
  activeTab?: string;
}

const { penName, activeTab } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{penName} — Dashboard Signature</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    style="margin:0;background:#EAE0D3;font-family:Lora,Georgia,serif;color:#3B2A28"
  >
    <!-- Banner -->
    <div
      style="background:#FFF3CD;color:#7A5A50;text-align:center;padding:10px 16px;font-size:13px;border-bottom:1px solid rgba(122,51,65,.12)"
    >
      Simulasi demo — perubahan tidak ke server
    </div>

    <div style="display:flex;min-height:calc(100vh - 41px)">
      <!-- Sidebar -->
      <aside
        style="width:248px;flex:none;background:#3B2A28;color:#D9C4BB;display:flex;flex-direction:column;position:sticky;top:0;height:calc(100vh - 41px);box-sizing:border-box;padding:24px 16px"
      >
        <div style="padding:0 10px 20px;border-bottom:1px solid rgba(217,196,187,.18)">
          <p
            style="margin:0;font-family:'Playfair Display',serif;font-size:19px;font-weight:600;color:#FBF6EF"
          >
            Homebase Studio
          </p>
          <p style="margin:4px 0 0;font-size:12px;font-style:italic;color:#B99A8E">
            ratnamaharani.id
          </p>
        </div>

        <slot name="nav" />

        <div style="margin-top:auto;display:flex;flex-direction:column;gap:10px;padding:0 4px">
          <a
            href="/"
            style="display:flex;align-items:center;justify-content:center;height:44px;border:1px solid rgba(217,196,187,.35);border-radius:12px;font-size:13px;color:#D9C4BB;text-decoration:none"
          >
            Lihat Situs &rarr;
          </a>
          <div
            style="display:flex;align-items:center;gap:10px;padding:10px 8px;border-radius:12px;background:rgba(217,196,187,.08)"
          >
            <div
              style="width:36px;height:36px;border-radius:50%;background:repeating-linear-gradient(45deg,#7A5A50 0 6px,#8A6A5E 6px 12px);flex:none"
            ></div>
            <div>
              <p style="margin:0;font-size:13px;font-weight:600;color:#FBF6EF">
                {penName}
              </p>
              <p style="margin:0;font-size:11px;color:#B99A8E">Paket Signature</p>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Content -->
      <main
        style="flex:1;min-width:0;padding:36px 44px 56px;box-sizing:border-box;background:#F3EBE0"
      >
        <slot />
      </main>
    </div>
  </body>
</html>
