---
const themes = [
  {
    key: 'maroon',
    nama: 'Maroon Klasik',
    desc: 'Hangat, elegan, khas novel romance premium.',
    bg: '#FBF6EF',
    hero: 'linear-gradient(180deg,#F4E3DE,#FBF6EF)',
    primary: '#7A3341',
    deep: '#5C2430',
    ink: '#3B2A28',
    soft: '#F4E3DE',
  },
  {
    key: 'rose',
    nama: 'Dusty Rose',
    desc: 'Lebih lembut dan feminin, nuansa merah muda pudar.',
    bg: '#FCF3F1',
    hero: 'linear-gradient(180deg,#F3DCD9,#FCF3F1)',
    primary: '#A4586A',
    deep: '#7C3A4C',
    ink: '#42272E',
    soft: '#F3DCD9',
  },
  {
    key: 'sage',
    nama: 'Sage Tenang',
    desc: 'Krem dengan hijau sage — kalem dan membumi.',
    bg: '#F6F4EC',
    hero: 'linear-gradient(180deg,#E4EADB,#F6F4EC)',
    primary: '#5E7A5C',
    deep: '#3F5A3E',
    ink: '#2F3A2C',
    soft: '#E4EADB',
  },
  {
    key: 'navy',
    nama: 'Navy Malam',
    desc: 'Krem dengan biru tua — anggun dan berkelas.',
    bg: '#F5F2EC',
    hero: 'linear-gradient(180deg,#DDE2EC,#F5F2EC)',
    primary: '#3E5175',
    deep: '#2A3A57',
    ink: '#25293A',
    soft: '#DDE2EC',
  },
  {
    key: 'terracotta',
    nama: 'Terakota',
    desc: 'Oranye-bata hangat, terasa akrab dan bersahaja.',
    bg: '#FBF4EC',
    hero: 'linear-gradient(180deg,#F4DFC9,#FBF4EC)',
    primary: '#B06A3C',
    deep: '#8A4E2A',
    ink: '#3E2C20',
    soft: '#F4DFC9',
  },
];

// Active is client-side; default to maroon for SSR
const active = themes[0];
---

<div>
  <div
    style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:8px"
  >
    <div>
      <h1
        style="margin:0 0 6px;font-family:'Playfair Display',serif;font-size:32px;font-weight:600;color:#3B2A28"
      >
        Tema Situs
      </h1>
      <p style="margin:0;max-width:560px;font-size:14px;line-height:1.6;color:#7A5A50">
        Pilih palet warna untuk situs publikmu. Ini demo — perubahan hanya terlihat di dashboard ini.
      </p>
    </div>
  </div>

  <!-- Current Selection Label -->
  <div style="display:flex;align-items:center;gap:8px;margin:22px 0 14px">
    <span style="font-size:12px;letter-spacing:.1em;color:#8A6A5E;font-weight:600">SEDANG DIPRATINJAU</span>
    <span id="tema-aktif-nama" style="font-family:'Playfair Display',serif;font-size:16px;font-weight:600;color:{active.primary}">
      {active.nama}
    </span>
  </div>
  <p id="tema-save-note" style="margin:0 0 14px;font-size:12px;color:#9A8078">Klik palet untuk menerapkan &amp; menyimpan pilihan (simulasi).</p>

  <!-- Theme Swatches -->
  <div
    id="swatches"
    style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:32px"
  >
    {themes.map((t) => (
      <button
        class="theme-swatch"
        data-theme={t.key}
        data-theme-nama={t.nama}
        data-theme-primary={t.primary}
        data-theme-deep={t.deep}
        data-theme-ink={t.ink}
        data-theme-soft={t.soft}
        data-theme-bg={t.bg}
        data-theme-hero={t.hero}
        data-theme-nama={t.nama}
        class="theme-swatch"
        style="text-align:left;background:{t.bg};border:2px solid {t.key === 'maroon' ? t.primary : 'rgba(122,51,65,.14)'};border-radius:18px;padding:0;overflow:hidden;cursor:pointer;box-shadow:0 2px 12px rgba(92,36,48,.07)"
      >
        <div
          style="height:120px;background:{t.hero};position:relative;padding:16px 18px;box-sizing:border-box"
        >
          {t.key === 'maroon' && (
            <span
              class="check-mark"
              style="position:absolute;top:12px;right:12px;width:24px;height:24px;border-radius:50%;background:{t.primary};color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px"
            >
              &#10003;
            </span>
          )}
          <div
            style="width:34px;height:34px;border-radius:50%;background:{t.soft};border:1px solid {t.primary};margin-bottom:10px"
          ></div>
          <p
            style="margin:0;font-family:'Playfair Display',serif;font-size:17px;font-weight:600;color:{t.ink};line-height:1.2"
          >
            Ratna Maharani
          </p>
          <p style="margin:3px 0 0;font-size:10px;font-style:italic;color:{t.primary}">
            Penulis romance keluarga
          </p>
        </div>
        <div style="padding:14px 18px 16px">
          <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px">
            <span
              style="height:22px;padding:0 12px;display:flex;align-items:center;border-radius:999px;background:{t.primary};color:#fff;font-size:9px;font-weight:600"
            >
              Baca di KBM
            </span>
            <span
              style="height:22px;padding:0 12px;display:flex;align-items:center;border-radius:999px;background:none;border:1px solid {t.primary};color:{t.primary};font-size:9px;font-weight:600"
            >
              Bonus
            </span>
          </div>
          <div style="display:flex;gap:6px;margin-bottom:12px">
            <span style="width:22px;height:12px;border-radius:3px;background:{t.deep}"></span>
            <span style="width:22px;height:12px;border-radius:3px;background:{t.primary}"></span>
            <span style="width:22px;height:12px;border-radius:3px;background:{t.soft}"></span>
            <span style="width:22px;height:12px;border-radius:3px;background:{t.ink}"></span>
          </div>
          <p
            style="margin:0 0 3px;font-family:'Playfair Display',serif;font-size:16px;font-weight:600;color:{t.ink}"
          >
            {t.nama}
          </p>
          <p style="margin:0;font-size:12px;line-height:1.5;color:#7A5A50">
            {t.desc}
          </p>
        </div>
      </button>
    ))}
  </div>

  <!-- Live Preview Panel -->
  <div
    id="preview-panel"
    style="background:{active.bg};border:1px solid rgba(122,51,65,.14);border-radius:20px;overflow:hidden"
  >
    <div
      style="padding:12px 22px;border-bottom:1px solid rgba(122,51,65,.1);display:flex;align-items:center;gap:8px"
    >
      <span style="width:10px;height:10px;border-radius:50%;background:#D8A7A4"></span>
      <span style="width:10px;height:10px;border-radius:50%;background:#E4C08A"></span>
      <span style="width:10px;height:10px;border-radius:50%;background:#B7C9A8"></span>
      <span style="margin-left:10px;font-size:12px;color:#9A8078"
        >ratnamaharani.id — pratinjau langsung</span
      >
    </div>
    <div id="preview-hero" style="padding:44px 40px;background:{active.hero};text-align:center">
      <span
        id="preview-badge"
        style="display:inline-flex;align-items:center;gap:8px;background:{active.deep};color:#fff;border-radius:999px;padding:7px 16px;font-size:12px;margin-bottom:16px"
      >
        &#9733; Penulis Terlaris KBM App 2024
      </span>
      <h2 id="preview-name" style="margin:0 0 8px;font-family:'Playfair Display',serif;font-size:38px;font-weight:600;color:{active.ink}">
        Ratna Maharani
      </h2>
      <p id="preview-tagline" style="margin:0 0 22px;font-style:italic;font-size:17px;color:{active.primary}">
        Penulis romance keluarga &amp; rumah tangga
      </p>
      <div style="display:flex;gap:12px;justify-content:center">
        <span
          id="preview-btn-primary"
          style="height:46px;padding:0 24px;display:flex;align-items:center;border-radius:12px;background:{active.primary};color:#fff;font-size:14px;font-weight:600"
        >
          Baca di KBM &rarr;
        </span>
        <span
          id="preview-btn-outline"
          style="height:46px;padding:0 24px;display:flex;align-items:center;border-radius:12px;background:none;border:1.5px solid {active.primary};color:{active.primary};font-size:14px;font-weight:600"
        >
          Ruang Bonus
        </span>
      </div>
    </div>
  </div>
  <p style="margin:14px 2px 0;font-size:12px;color:#9A8078">
    Ini pratinjau — hanya untuk demo. Tema tidak tersimpan permanen.
  </p>
</div>

<script>
  // Client-side theme switching
  const swatches = document.querySelectorAll<HTMLElement>('.theme-swatch');
  const temaAktifNama = document.getElementById('tema-aktif-nama')!;
  const previewPanel = document.getElementById('preview-panel')!;
  const previewHero = document.getElementById('preview-hero')!;
  const previewBadge = document.getElementById('preview-badge')!;
  const previewName = document.getElementById('preview-name')!;
  const previewTagline = document.getElementById('preview-tagline')!;
  const previewBtnPrimary = document.getElementById('preview-btn-primary')!;
  const previewBtnOutline = document.getElementById('preview-btn-outline')!;

  function selectTheme(btn: HTMLElement) {
    const data = btn.dataset;
    const primary = data.themePrimary!;
    const deep = data.themeDeep!;
    const ink = data.themeInk!;
    const bg = data.themeBg!;
    const hero = data.themeHero!;
    const nama = data.themeNama!;

    // Update all check marks
    document.querySelectorAll('.check-mark').forEach((c) => c.remove());

    // Add check to selected
    const heroDiv = btn.querySelector('div') as HTMLElement;
    if (heroDiv) {
      const check = document.createElement('span');
      check.className = 'check-mark';
      check.style.cssText = `position:absolute;top:12px;right:12px;width:24px;height:24px;border-radius:50%;background:${primary};color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px`;
      check.textContent = '\u2713';
      heroDiv.style.position = 'relative';
      heroDiv.appendChild(check);
    }

    // Update borders
    swatches.forEach((s) => {
      s.style.borderColor = 'rgba(122,51,65,.14)';
    });
    btn.style.borderColor = primary;

    // Update preview
    temaAktifNama.textContent = nama;
    temaAktifNama.style.color = primary;
    previewPanel.style.background = bg;
    previewHero.style.background = hero;
    previewBadge.style.background = deep;
    previewName.style.color = ink;
    previewTagline.style.color = primary;
    previewBtnPrimary.style.background = primary;
    previewBtnOutline.style.borderColor = primary;
    previewBtnOutline.style.color = primary;

    // Set CSS vars on root for demo
    const root = document.documentElement;
    root.style.setProperty('--color-rose', primary);
    root.style.setProperty('--color-rose-deep', deep);
    root.style.setProperty('--color-ink', ink);
    root.style.setProperty('--color-blush', data.themeSoft!);
    root.style.setProperty('--color-paper', bg);

    // Persist theme key for presentation
    try {
      const key = 'ma-demo-signature';
      const raw = localStorage.getItem(key);
      const state = raw ? JSON.parse(raw) : {};
      state.theme = data.theme || nama;
      localStorage.setItem(key, JSON.stringify(state));
      const note = document.getElementById('tema-save-note');
      if (note) note.textContent = `Tema “${nama}” tersimpan di perangkat (simulasi).`;
    } catch (_) {}
  }

  swatches.forEach((btn) => {
    btn.addEventListener('click', () => selectTheme(btn));
  });

  // hydrate saved theme if any
  try {
    const raw = localStorage.getItem('ma-demo-signature');
    if (raw) {
      const state = JSON.parse(raw);
      if (state.theme) {
        const match = Array.from(swatches).find(
          (s) => s.dataset.theme === state.theme || s.dataset.themeNama === state.theme,
        );
        if (match) selectTheme(match as HTMLElement);
      }
    }
  } catch (_) {}
</script>
