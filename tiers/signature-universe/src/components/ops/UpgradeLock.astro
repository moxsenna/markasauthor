---
export interface Props {
  label?: string;
}

const { label = 'Upgrade ke Author Homebase' } = Astro.props;
---

<span
  style="display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;color:#9A8078;background:rgba(217,196,187,.18);border-radius:999px;padding:3px 10px;margin-left:auto"
  title={label}
>
  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
    <rect x="2.5" y="5" width="7" height="5" rx="1" stroke="#9A8078" stroke-width="0.8"/>
    <path d="M4 5V3.5a2 2 0 0 1 4 0V5" stroke="#9A8078" stroke-width="0.8"/>
  </svg>
  {label}
</span>
