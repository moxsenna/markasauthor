---
import type { Work } from '../../lib/types';

export interface Props {
  works: Work[];
  tier: string;
}

const { works, tier } = Astro.props;
const seed = JSON.stringify(works);
---

<div data-ops-karya data-tier={tier}>
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:22px;flex-wrap:wrap">
    <div>
      <h1 style="margin:0 0 6px;font-family:'Playfair Display',serif;font-size:32px;font-weight:600;color:#3B2A28">Rak Buku</h1>
      <p style="margin:0;font-size:14px;color:#7A5A50">Urutkan, edit metadata, tambah/hapus karya (simulasi).</p>
    </div>
    <button type="button" id="karya-add" style="height:48px;padding:0 20px;background:#7A3341;color:#FBF6EF;border:none;border-radius:12px;font-family:Lora,serif;font-size:14px;font-weight:600;cursor:pointer">+ Tambah Karya</button>
  </div>
  <div id="karya-list" style="display:flex;flex-direction:column;gap:10px"></div>

  <div id="karya-form" hidden style="margin-top:18px;background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;padding:22px;display:flex;flex-direction:column;gap:12px">
    <h2 id="karya-form-title" style="margin:0;font-family:'Playfair Display',serif;font-size:20px;color:#3B2A28">Karya baru</h2>
    <input type="hidden" id="karya-slug" />
    <label style="font-size:13px;font-weight:600;color:#5A453F">Judul<input id="karya-title" style="display:block;width:100%;margin-top:6px;height:46px;padding:0 12px;border-radius:10px;border:1px solid rgba(122,51,65,.25);background:#FFFDF9;font-family:Lora,serif;box-sizing:border-box" /></label>
    <label style="font-size:13px;font-weight:600;color:#5A453F">Genre<input id="karya-genre" style="display:block;width:100%;margin-top:6px;height:46px;padding:0 12px;border-radius:10px;border:1px solid rgba(122,51,65,.25);background:#FFFDF9;font-family:Lora,serif;box-sizing:border-box" /></label>
    <label style="font-size:13px;font-weight:600;color:#5A453F">Hook 1 kalimat<textarea id="karya-hook" rows="2" style="display:block;width:100%;margin-top:6px;padding:10px 12px;border-radius:10px;border:1px solid rgba(122,51,65,.25);background:#FFFDF9;font-family:Lora,serif;box-sizing:border-box"></textarea></label>
    <label style="font-size:13px;font-weight:600;color:#5A453F">URL KBM<input id="karya-url" placeholder="https://kbm.id/..." style="display:block;width:100%;margin-top:6px;height:46px;padding:0 12px;border-radius:10px;border:1px solid rgba(122,51,65,.25);background:#FFFDF9;font-family:Lora,serif;box-sizing:border-box" /></label>
    <label style="font-size:13px;font-weight:600;color:#5A453F">Status
      <select id="karya-status" style="display:block;width:100%;margin-top:6px;height:46px;padding:0 12px;border-radius:10px;border:1px solid rgba(122,51,65,.25);background:#FFFDF9;font-family:Lora,serif">
        <option value="TAYANG">TAYANG</option>
        <option value="TAMAT">TAMAT</option>
      </select>
    </label>
    <label style="font-size:13px;font-weight:600;color:#5A453F">Pembaca / label<input id="karya-readers" style="display:block;width:100%;margin-top:6px;height:46px;padding:0 12px;border-radius:10px;border:1px solid rgba(122,51,65,.25);background:#FFFDF9;font-family:Lora,serif;box-sizing:border-box" /></label>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <button type="button" id="karya-save" style="height:46px;padding:0 20px;background:#7A3341;color:#FBF6EF;border:none;border-radius:11px;font-family:Lora,serif;font-weight:600;cursor:pointer">Simpan</button>
      <button type="button" id="karya-cancel" style="height:46px;padding:0 20px;background:none;border:1.5px solid #7A3341;color:#7A3341;border-radius:11px;font-family:Lora,serif;font-weight:600;cursor:pointer">Batal</button>
    </div>
  </div>
  <p style="margin:16px 2px 0;font-size:12px;color:#9A8078">Tanpa isi chapter. Link wajib ke KBM.</p>
</div>

<script type="application/json" id="karya-seed" set:html={seed} />

<script>
  import type { Work } from '../../lib/types';
  import { loadContent, saveContent, moveItem, toast } from '../../lib/demo-store';
  import author from '../../data/author.json';

  const root = document.querySelector('[data-ops-karya]') as HTMLElement;
  const tier = root?.dataset.tier || 'signature';
  const seed = JSON.parse(document.getElementById('karya-seed')!.textContent || '[]') as Work[];

  function getList(): Work[] {
    const c = loadContent(tier, author as any);
    return c.works?.length ? c.works : seed;
  }
  function persist(list: Work[]) {
    saveContent(tier, { works: list }, author as any);
    toast('Rak buku disimpan');
    render();
  }
  function esc(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function render() {
    const list = getList();
    const el = document.getElementById('karya-list')!;
    el.innerHTML = list
      .map(
        (w, i) => `
      <div data-i="${i}" style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:14px;padding:16px 18px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <div style="flex:none;width:44px;aspect-ratio:2/3;border-radius:4px;padding:4px;display:flex;align-items:center;justify-content:center;background:${w.coverBg}">
          <span style="font-family:'Playfair Display',serif;font-size:8px;font-weight:600;color:#FBF6EF;text-align:center">${esc(w.title)}</span>
        </div>
        <div style="flex:1;min-width:160px">
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <span style="font-size:12px;color:#8A6A5E;font-weight:600">${esc(w.genre)}</span>
            <span style="font-size:10px;color:#7A3341;font-weight:600;background:#F4E3DE;border-radius:999px;padding:3px 8px">${w.status}</span>
          </div>
          <h3 style="margin:4px 0 2px;font-family:'Playfair Display',serif;font-size:17px;font-weight:600;color:#3B2A28">${esc(w.title)}</h3>
          <p style="margin:0;font-size:13px;color:#6A5248;font-style:italic">“${esc(w.hook)}”</p>
          <p style="margin:4px 0 0;font-size:12px;color:#9A8078">${esc(w.readers)}</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:6px">
          <button type="button" data-act="up" style="min-height:34px;padding:0 12px;border-radius:8px;border:1px solid rgba(122,51,65,.25);background:#FFFDF9;cursor:pointer;font-family:Lora,serif;font-size:12px">↑ Naik</button>
          <button type="button" data-act="down" style="min-height:34px;padding:0 12px;border-radius:8px;border:1px solid rgba(122,51,65,.25);background:#FFFDF9;cursor:pointer;font-family:Lora,serif;font-size:12px">↓ Turun</button>
          <button type="button" data-act="edit" style="min-height:34px;padding:0 12px;border-radius:8px;border:1.5px solid #7A3341;background:none;color:#7A3341;cursor:pointer;font-family:Lora,serif;font-size:12px;font-weight:600">Edit</button>
          <button type="button" data-act="del" style="min-height:34px;padding:0 12px;border-radius:8px;border:1.5px solid #B0483C;background:none;color:#B0483C;cursor:pointer;font-family:Lora,serif;font-size:12px;font-weight:600">Hapus</button>
        </div>
      </div>`,
      )
      .join('');

    el.querySelectorAll('[data-i]').forEach((row) => {
      const i = Number((row as HTMLElement).dataset.i);
      row.querySelector('[data-act="up"]')?.addEventListener('click', () => persist(moveItem(getList(), i, -1)));
      row.querySelector('[data-act="down"]')?.addEventListener('click', () => persist(moveItem(getList(), i, 1)));
      row.querySelector('[data-act="edit"]')?.addEventListener('click', () => openForm(getList()[i]));
      row.querySelector('[data-act="del"]')?.addEventListener('click', () => {
        if (!confirm('Hapus karya ini dari rak?')) return;
        const list = getList().filter((_, idx) => idx !== i);
        persist(list);
      });
    });
  }

  function openForm(w?: Work) {
    const form = document.getElementById('karya-form')!;
    form.hidden = false;
    (document.getElementById('karya-form-title') as HTMLElement).textContent = w ? 'Edit karya' : 'Karya baru';
    (document.getElementById('karya-slug') as HTMLInputElement).value = w?.slug || '';
    (document.getElementById('karya-title') as HTMLInputElement).value = w?.title || '';
    (document.getElementById('karya-genre') as HTMLInputElement).value = w?.genre || 'Romance';
    (document.getElementById('karya-hook') as HTMLTextAreaElement).value = w?.hook || '';
    (document.getElementById('karya-url') as HTMLInputElement).value = w?.kbmUrl || '';
    (document.getElementById('karya-status') as HTMLSelectElement).value = w?.status || 'TAYANG';
    (document.getElementById('karya-readers') as HTMLInputElement).value = w?.readers || '';
    form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function slugify(t: string) {
    return t
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '')
      .slice(0, 48) || `karya-${Date.now()}`;
  }

  document.getElementById('karya-add')?.addEventListener('click', () => openForm());
  document.getElementById('karya-cancel')?.addEventListener('click', () => {
    document.getElementById('karya-form')!.hidden = true;
  });
  document.getElementById('karya-save')?.addEventListener('click', () => {
    const title = (document.getElementById('karya-title') as HTMLInputElement).value.trim();
    if (!title) return toast('Judul wajib');
    let slug = (document.getElementById('karya-slug') as HTMLInputElement).value || slugify(title);
    const url = (document.getElementById('karya-url') as HTMLInputElement).value.trim() || `https://kbm.id/demo/${slug}?ref=homebase`;
    const item: Work = {
      slug,
      title,
      genre: (document.getElementById('karya-genre') as HTMLInputElement).value.trim() || 'Romance',
      hook: (document.getElementById('karya-hook') as HTMLTextAreaElement).value.trim() || '—',
      readers: (document.getElementById('karya-readers') as HTMLInputElement).value.trim() || 'baru',
      tag: 'NOVEL',
      coverBg: 'linear-gradient(160deg,#5C2430,#7A3341)',
      coverSize: '16px',
      kbmUrl: url,
      status: (document.getElementById('karya-status') as HTMLSelectElement).value as 'TAYANG' | 'TAMAT',
    };
    const list = getList();
    const i = list.findIndex((w) => w.slug === slug);
    if (i >= 0) list[i] = { ...list[i], ...item };
    else list.push(item);
    document.getElementById('karya-form')!.hidden = true;
    persist(list);
  });

  render();
</script>
