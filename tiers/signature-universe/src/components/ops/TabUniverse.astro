---
import authorData from '../../data/author.json';
import type { AuthorData } from '../../lib/types';

const author = authorData as AuthorData;
const universe = author.universe;
const hasUniverse = !!universe;
const name = universe?.name ?? '';
const characters = universe?.characters ?? [];
const storyTimeline = universe?.storyTimeline ?? [];
const locations = universe?.locations ?? [];
const trivia = universe?.trivia ?? [];
---

{!hasUniverse && (
  <div style="text-align:center;padding:80px 20px">
    <h2 style="font-family:'Playfair Display',serif;font-size:24px;color:#3B2A28;margin-bottom:8px">
      Belum ada data semesta
    </h2>
    <p style="color:#7A5A50;font-size:14px">
      Tambahkan data universe di author.json.
    </p>
  </div>
)}

{hasUniverse && (

<div>
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px">
    <div>
      <h1 style="margin:0 0 6px;font-family:'Playfair Display',serif;font-size:32px;font-weight:600;color:#3B2A28">
        Semesta &ldquo;{name}&rdquo;
      </h1>
      <p style="margin:0;font-size:14px;color:#7A5A50">
        Kelola data semesta &mdash; tokoh, linimasa, lokasi, trivia.
      </p>
    </div>
    <a
      href="/universe"
      target="_blank"
      rel="noopener noreferrer"
      style="flex:none;display:flex;align-items:center;height:48px;padding:0 20px;background:none;border:1.5px solid #7A3341;color:#7A3341;border-radius:12px;font-size:14px;font-weight:600;text-decoration:none;white-space:nowrap"
    >
      Lihat Halaman Publik &rarr;
    </a>
  </div>

  <!-- Quick Stat Cards -->
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:22px">
    <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:14px;padding:16px 20px">
      <p style="margin:0;font-size:12px;color:#8A6A5E">Tokoh</p>
      <p style="margin:6px 0 0;font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:#5C2430">
        {characters.length}
      </p>
    </div>
    <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:14px;padding:16px 20px">
      <p style="margin:0;font-size:12px;color:#8A6A5E">Tonggak Cerita</p>
      <p style="margin:6px 0 0;font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:#5C2430">
        {storyTimeline.length}
      </p>
    </div>
    <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:14px;padding:16px 20px">
      <p style="margin:0;font-size:12px;color:#8A6A5E">Lokasi</p>
      <p style="margin:6px 0 0;font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:#5C2430">
        {locations.length}
      </p>
    </div>
    <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:14px;padding:16px 20px">
      <p style="margin:0;font-size:12px;color:#8A6A5E">Trivia</p>
      <p style="margin:6px 0 0;font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:#5C2430">
        {trivia.length}
      </p>
    </div>
  </div>

  <!-- Characters List -->
  <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;padding:20px 22px;margin-bottom:16px">
    <h2 style="margin:0 0 12px;font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:#3B2A28">
      Tokoh ({characters.length})
    </h2>
    <div style="display:flex;flex-direction:column;gap:8px">
      {characters.map((ch) => (
        <div style="display:flex;align-items:center;gap:12px;border-bottom:1px solid rgba(122,51,65,.08);padding-bottom:8px">
          <div style="flex:none;width:36px;height:36px;border-radius:50%;background:#7A3341;color:#FBF6EF;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:14px;font-weight:600">
            {ch.name.charAt(0)}
          </div>
          <div style="flex:1;min-width:0">
            <p style="margin:0;font-size:14px;font-weight:600;color:#3B2A28">{ch.name}</p>
            <p style="margin:2px 0 0;font-size:12px;color:#9A8078">{ch.role}</p>
          </div>
          {ch.relations.length > 0 && (
            <span style="flex:none;font-size:11px;color:#8A6A5E;background:#F4E3DE;border-radius:999px;padding:3px 10px">
              {ch.relations.length} relasi
            </span>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Story Timeline + Spoiler Toggles -->
  <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;padding:20px 22px;margin-bottom:16px">
    <h2 style="margin:0 0 12px;font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:#3B2A28">
      Linimasa Cerita ({storyTimeline.length})
    </h2>
    <div style="display:flex;flex-direction:column;gap:8px">
      {storyTimeline.map((item) => (
        <div style="display:flex;align-items:center;gap:12px;border-bottom:1px solid rgba(122,51,65,.08);padding-bottom:8px">
          <div style="flex:1;min-width:0">
            <p style="margin:0;font-size:14px;font-weight:600;color:#3B2A28">{item.title}</p>
            <p style="margin:2px 0 0;font-size:12px;color:#9A8078">{item.body}</p>
          </div>
          <div style="flex:none;display:flex;align-items:center;gap:8px">
            <span
              style={`font-size:10px;letter-spacing:.1em;font-weight:600;border-radius:999px;padding:3px 8px;color:${item.spoiler ? '#B0483C' : '#1E7A57'};border:1px solid ${item.spoiler ? 'rgba(176,72,60,.4)' : 'rgba(30,122,87,.4)'}`}
            >
              {item.spoiler ? 'SPOILER' : 'AMAN'}
            </span>
            <button
              type="button"
              class="universe-spoiler-toggle"
              data-spoiler-id={item.id}
              data-spoiler={String(item.spoiler)}
              style={`cursor:pointer;min-height:30px;padding:0 12px;border-radius:8px;font-family:Lora,Georgia,serif;font-size:11px;font-weight:600;background:${item.spoiler ? '#F4E3DE' : '#E7F0E6'};color:${item.spoiler ? '#B0483C' : '#1E7A57'};border:1px solid ${item.spoiler ? 'rgba(176,72,60,.3)' : 'rgba(30,122,87,.3)'}`}
            >
              {item.spoiler ? 'Tandai Aman' : 'Tandai Spoiler'}
            </button>
          </div>
        </div>
      ))}
    </div>
    <p style="margin:12px 0 0;font-size:11px;color:#9A8078">
      Toggle spoiler disimpan di localStorage &mdash; perubahan bersifat lokal.
    </p>
  </div>

  <!-- Trivia List -->
  <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;padding:20px 22px;margin-bottom:16px">
    <h2 style="margin:0 0 12px;font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:#3B2A28">
      Trivia ({trivia.length})
    </h2>
    <div style="display:flex;flex-direction:column;gap:8px">
      {trivia.map((item, i) => (
        <div style="display:flex;flex-direction:column;gap:4px;border-bottom:1px solid rgba(122,51,65,.08);padding-bottom:8px">
          <p style="margin:0;font-size:13px;font-weight:600;color:#7A3341">Q{i + 1}: {item.q}</p>
          <p style="margin:0;font-size:13px;color:#5A453F">{item.a}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Locations List -->
  <div style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:18px;padding:20px 22px">
    <h2 style="margin:0 0 12px;font-family:'Playfair Display',serif;font-size:18px;font-weight:600;color:#3B2A28">
      Lokasi ({locations.length})
    </h2>
    <div style="display:flex;flex-direction:column;gap:8px">
      {locations.map((loc) => (
        <div style="display:flex;align-items:center;gap:12px;border-bottom:1px solid rgba(122,51,65,.08);padding-bottom:8px">
          <div style="flex:none;width:36px;height:36px;border-radius:10px;background:#F4E3DE;border:1px solid rgba(122,51,65,.2);display:flex;align-items:center;justify-content:center;font-size:16px">
            &#128205;
          </div>
          <div style="flex:1;min-width:0">
            <p style="margin:0;font-size:14px;font-weight:600;color:#3B2A28">{loc.name}</p>
            <p style="margin:2px 0 0;font-size:12px;color:#9A8078">{loc.blurb}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
)}

<script>
  // Client-side: spoiler toggle with localStorage mock
  document.querySelectorAll<HTMLElement>('.universe-spoiler-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = btn.dataset.spoiler === 'true';
      const newVal = !current;
      const spoilerId = btn.dataset.spoilerId || '';

      // Save to localStorage
      try {
        const stored = JSON.parse(localStorage.getItem('ma-universe-spoilers') || '{}');
        stored[spoilerId] = newVal;
        localStorage.setItem('ma-universe-spoilers', JSON.stringify(stored));
      } catch (_) { /* ignore */ }

      // Update button
      btn.dataset.spoiler = String(newVal);
      btn.textContent = newVal ? 'Tandai Aman' : 'Tandai Spoiler';
      btn.style.background = newVal ? '#F4E3DE' : '#E7F0E6';
      btn.style.color = newVal ? '#B0483C' : '#1E7A57';
      btn.style.borderColor = newVal ? 'rgba(176,72,60,.3)' : 'rgba(30,122,87,.3)';

      // Update badge
      const badge = btn.parentElement?.querySelector('span:first-child') as HTMLElement | null;
      if (badge) {
        badge.textContent = newVal ? 'SPOILER' : 'AMAN';
        badge.style.color = newVal ? '#B0483C' : '#1E7A57';
        badge.style.borderColor = newVal ? 'rgba(176,72,60,.4)' : 'rgba(30,122,87,.4)';
      }
    });
  });
</script>
