---
import type { ReadingNode } from '../../lib/types';

export interface Props {
  readingMain: ReadingNode[];
  readingSide: { title: string; desc: string; coverBg: string; kbmUrl: string }[];
}

const { readingMain, readingSide } = Astro.props;
const allNodes = [
  ...readingMain.map((n) => ({ ...n, kind: 'main' as const })),
  ...readingSide.map((n) => ({ ...n, kind: 'side' as const })),
];
---

<div>
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px">
    <div>
      <h1 style="margin:0 0 6px;font-family:'Playfair Display',serif;font-size:32px;font-weight:600;color:#3B2A28">
        Peta Baca
      </h1>
      <p style="margin:0;font-size:14px;color:#7A5A50">
        Urutan baca yang ditampilkan di halaman publik /peta-baca.
      </p>
    </div>
  </div>

  <div style="display:flex;flex-direction:column;gap:8px">
    {allNodes.map((node, i) => (
      <div
        style="background:#FBF6EF;border:1px solid rgba(122,51,65,.14);border-radius:14px;padding:16px 20px;display:flex;align-items:center;gap:14px"
      >
        <div
          class="peta-cover-thumb"
          style={`flex:none;width:40px;aspect-ratio:2/3;border-radius:3px;display:flex;align-items:center;justify-content:center;padding:4px;background:${node.coverBg}`}
        >
          <span style="font-family:'Playfair Display',serif;font-size:7px;font-weight:600;line-height:1.3;color:#FBF6EF;text-align:center">
            {node.title}
          </span>
        </div>
        <div style="flex:1;min-width:0">
          <div style="display:flex;align-items:center;gap:8px">
            <span style="font-size:12px;letter-spacing:.06em;color:#8A6A5E;font-weight:600">
              {node.kind === 'main' ? 'SEMESTA' : 'LEPAS'}
            </span>
            <span style="font-size:10px;color:#8A6A5E">#{i + 1}</span>
          </div>
          <h3 style="margin:3px 0 0;font-family:'Playfair Display',serif;font-size:17px;font-weight:600;color:#3B2A28;line-height:1.3">
            {node.title}
          </h3>
          <p style="margin:3px 0 0;font-size:12px;color:#9A8078">{node.desc}</p>
        </div>
        <span
          class="peta-toggle-published"
          style="flex:none;width:36px;height:22px;border-radius:11px;background:#7A3341;position:relative;cursor:pointer"
          data-published="true"
        >
          <span
            style="position:absolute;top:2px;right:2px;width:18px;height:18px;border-radius:50%;background:#FBF6EF;transition:all .2s"
          ></span>
        </span>
      </div>
    ))}
  </div>

  <p style="margin:16px 2px 0;font-size:12px;color:#9A8078">
    Toggle tampil/sembunyi bersifat lokal &mdash; simulasi.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.peta-toggle-published').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const isPublished = toggle.dataset.published === 'true';
      const newPublished = !isPublished;
      toggle.dataset.published = String(newPublished);

      const knob = toggle.querySelector('span') as HTMLElement;
      if (newPublished) {
        toggle.style.background = '#7A3341';
        knob.style.right = '2px';
        knob.style.left = 'auto';
      } else {
        toggle.style.background = '#C4A9A0';
        knob.style.right = 'auto';
        knob.style.left = '2px';
      }
    });
  });
</script>
