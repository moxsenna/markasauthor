---
export interface Props {
  penName: string;
  currentPath?: string;
}

const { penName, currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Ruang Bonus', href: '/bonus' },
  { label: 'Peta Baca', href: '/peta-baca' },
  { label: 'Kolaborasi', href: '/kolaborasi' },
  { label: 'Karya', href: '/karya' },
  { label: 'Semesta', href: '/universe' },
];
---

<header class="sticky top-0 z-40 flex items-center justify-between px-5 py-3 bg-paper/95 backdrop-blur-[8px] border-b border-rose/12">
  <a href="/" class="font-serif text-[19px] font-semibold tracking-[.02em] text-rose-deep no-underline">
    {penName}
  </a>

  <!-- Desktop nav (md+) -->
  <nav class="hidden md:flex items-center gap-1">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`px-3 py-2 rounded-[10px] text-[14px] font-medium no-underline transition-colors ${
            isActive
              ? 'bg-blush text-rose-deep font-semibold'
              : 'text-muted hover:text-ink hover:bg-blush/50'
          }`}
        >
          {item.label}
        </a>
      );
    })}
  </nav>

  <!-- Mobile hamburger -->
  <button
    id="menu-toggle"
    class="md:hidden w-[44px] h-[44px] flex flex-col items-center justify-center gap-[5px] bg-transparent border-none cursor-pointer rounded-[10px]"
    aria-label="Buka menu"
  >
    <span class="block w-[20px] h-[2px] bg-rose-deep rounded-[2px]"></span>
    <span class="block w-[20px] h-[2px] bg-rose-deep rounded-[2px]"></span>
    <span class="block w-[14px] h-[2px] bg-rose-deep rounded-[2px] self-end mr-[12px]"></span>
  </button>
</header>

<!-- Mobile menu overlay -->
<div id="mobile-menu-overlay" class="hidden fixed inset-0 z-50 bg-ink/50 md:hidden" aria-hidden="true"></div>
<nav id="mobile-menu" class="hidden fixed top-0 right-0 bottom-0 z-51 w-[280px] bg-paper flex flex-col p-5 shadow-[-12px_0_32px_rgba(59,42,40,.25)] md:hidden">
  <div class="flex items-center justify-between mb-[18px]">
    <span class="font-serif italic text-[15px] text-muted">Menu</span>
    <button
      id="menu-close"
      class="w-[44px] h-[44px] bg-transparent border-none cursor-pointer text-[22px] text-rose-deep"
      aria-label="Tutup menu"
    >&#10005;</button>
  </div>
  <div class="flex flex-col gap-[2px]">
    {navItems.map((item, i) => {
      const num = String(i + 1).padStart(2, '0');
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`flex items-baseline gap-[10px] text-left rounded-[12px] py-[14px] px-[14px] font-serif text-[19px] font-medium text-ink no-underline ${
            isActive ? 'bg-blush' : 'bg-transparent'
          }`}
        >
          <span class="font-body text-[11px] text-faint">{num}</span>
          <span>{item.label}</span>
        </a>
      );
    })}
  </div>
  <div class="mt-auto border-t border-rose/14 pt-[18px] flex flex-col gap-[10px]">
    <a
      href="https://whatsapp.com/channel/ratnamaharani"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center min-h-[48px] bg-wa text-paper rounded-[14px] text-[15px] font-semibold no-underline"
    >
      Ikuti Saluran WhatsApp
    </a>
    <p class="m-0 text-[12px] leading-[1.5] text-muted text-center">
      Kabar bab baru, langsung di WhatsApp-mu.
    </p>
  </div>
</nav>

<script>
  (function () {
    const toggle = document.getElementById('menu-toggle');
    const close = document.getElementById('menu-close');
    const overlay = document.getElementById('mobile-menu-overlay');
    const menu = document.getElementById('mobile-menu');

    function openMenu() {
      overlay?.classList.remove('hidden');
      menu?.classList.remove('hidden');
    }
    function closeMenu() {
      overlay?.classList.add('hidden');
      menu?.classList.add('hidden');
    }

    toggle?.addEventListener('click', openMenu);
    close?.addEventListener('click', closeMenu);
    overlay?.addEventListener('click', closeMenu);

    // Close on nav link click
    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  })();
</script>
