---
import type { TimelineItem } from '../../lib/types';

export interface Props {
  timeline: TimelineItem[];
}

const { timeline } = Astro.props;
---

<section class="pt-10 px-6 pb-3">
  <h2 class="m-0 mb-1 font-serif text-[26px] font-semibold text-ink">Perjalanan Menulis</h2>
  <p class="m-0 mb-[22px] text-[14px] leading-[1.6] text-muted">
    Dari bab pertama sampai hari ini.
  </p>

  <div class="flex flex-col">
    {timeline.map((item, i) => {
      const isLast = i === timeline.length - 1;
      return (
        <div class="flex gap-4">
          {/* Dot + line */}
          <div class="flex flex-col items-center w-[14px] flex-none">
            <span
              class="block w-[14px] h-[14px] rounded-full border-[3px] border-blush flex-none mt-1"
              style={`background:${item.dot}`}
            ></span>
            {!isLast && (
              <span
                class="block w-[1.5px] flex-1 bg-rose/25"
              ></span>
            )}
          </div>

          {/* Content */}
          <div class="pb-[26px]">
            <span class="text-[12px] tracking-[.1em] text-alert font-semibold">
              {item.year}
            </span>
            <h3 class="mt-[3px] mb-1 font-serif text-[19px] font-semibold text-ink leading-[1.3]">
              {item.title}
            </h3>
            <p class="m-0 text-[14px] leading-[1.6] text-ink-soft">
              {item.detail}
            </p>
          </div>
        </div>
      );
    })}
  </div>
</section>
