---
import type { Work } from '../../lib/types';

export interface Props {
  works: Work[];
}

const { works } = Astro.props;
---

<section class="pt-9 pb-2 px-5">
  <div class="flex items-baseline justify-between mb-1">
    <h2 class="m-0 font-serif text-[26px] font-semibold text-ink">Rak Buku</h2>
    <span class="text-[12px] text-faint">{works.length} karya &middot; semua di KBM App</span>
  </div>
  <p class="m-0 mb-[18px] text-[14px] leading-[1.6] text-muted">
    Semua cerita dibaca gratis lewat aplikasi KBM.
  </p>

  <div class="grid grid-cols-2 gap-[18px_16px]">
    {works.map((work) => (
      <div class="flex flex-col gap-[9px]">
        <!-- Cover -->
        <div
          class="relative aspect-[2/3] rounded-[8px] shadow-[0_6px_16px_rgba(92,36,48,.25)] p-[14px_12px] flex flex-col overflow-hidden"
          style={`background:${work.coverBg}`}
        >
          <div class="absolute inset-[7px] border border-paper/35 rounded-[4px] pointer-events-none"></div>
          <span class="text-[9px] tracking-[.16em] text-paper/75 text-center mb-auto">
            {work.tag}
          </span>
          <h3
            class="my-auto font-serif font-semibold leading-[1.25] text-paper text-center"
            style={`font-size:${work.coverSize}`}
          >
            {work.title}
          </h3>
          <span class="text-[9px] tracking-[.14em] text-paper/75 text-center mt-auto">
            RATNA MAHARANI
          </span>
        </div>

        <!-- Info -->
        <div>
          <p class="m-0 text-[13px] font-semibold text-ink leading-[1.35]">{work.title}</p>
          <p class="mt-[2px] text-[12px] text-faint">{work.readers}</p>
        </div>

        <!-- Link -->
        <a
          href={work.kbmUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center min-h-[44px] bg-transparent border border-[1.5px] border-rose text-rose rounded-[11px] text-[14px] font-semibold no-underline"
        >
          Baca di KBM &rarr;
        </a>
      </div>
    ))}
  </div>
</section>
