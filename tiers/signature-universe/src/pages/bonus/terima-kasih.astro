---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/public/SiteHeader.astro';
import SiteFooter from '../../components/public/SiteFooter.astro';
import authorData from '../../data/author.json';
import type { AuthorData } from '../../lib/types';

const author = authorData as AuthorData;
---

<BaseLayout
  title={`Terima Kasih — ${author.penName}`}
  description="Bonusmu sudah terbuka. Jangan lupa ikuti Saluran WhatsApp."
>
  <SiteHeader penName={author.penName} currentPath="/bonus" />

  <main class="flex flex-col py-14 px-6 text-center flex-1">
    <div class="w-[72px] h-[72px] mx-auto mb-5 rounded-full bg-wa text-paper flex items-center justify-center text-[30px]">
      &#10003;
    </div>
    <h1 class="m-0 mb-[10px] font-serif text-[30px] font-semibold leading-[1.25] text-ink">
      Terima kasih, <span id="tk-reader-name">Pembaca</span>!
    </h1>
    <p class="m-0 mx-auto mb-7 max-w-[300px] text-[15px] leading-[1.7] text-ink-soft">
      Kamu sudah terdaftar. Dua langkah kecil lagi supaya tidak ketinggalan apa pun:
    </p>

    <div class="flex flex-col gap-3 max-w-[320px] mx-auto w-full">
      <a
        href="/bonus"
        class="flex items-center justify-center min-h-[54px] bg-rose text-paper rounded-[14px] text-[16px] font-semibold no-underline"
      >
        Buka Bonusmu &rarr;
      </a>
      <a
        href={author.waChannelUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center min-h-[54px] bg-wa text-paper rounded-[14px] text-[16px] font-semibold no-underline"
      >
        Ikuti Saluran WhatsApp
      </a>
    </div>

    <p class="mt-6 mx-auto max-w-[300px] text-[13px] leading-[1.6] text-faint">
      Saluran WhatsApp adalah cara tercepat tahu bab baru &mdash; cukup sekali ikuti.
    </p>
  </main>

  <SiteFooter author={author} />

  <script type="application/json" id="tk-fallback-data">
    {JSON.stringify(author.latestChapters)}
  </script>

  <script>
    import { loadDemoState } from '../../lib/demo-store';
    import type { LatestChapter } from '../../lib/types';

    const fallbackEl = document.getElementById('tk-fallback-data');
    const fallbackChapters: LatestChapter[] = fallbackEl ? JSON.parse(fallbackEl.textContent || '[]') : [];

    const state = loadDemoState('signature', fallbackChapters);
    const readerNameEl = document.getElementById('tk-reader-name');
    if (readerNameEl && state.readerName) {
      readerNameEl.textContent = state.readerName;
    }
  </script>
</BaseLayout>
