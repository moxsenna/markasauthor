---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/public/SiteHeader.astro';
import SiteFooter from '../components/public/SiteFooter.astro';
import authorData from '../data/author.json';
import type { AuthorData } from '../lib/types';

const author = authorData as AuthorData;
const { readingMain, readingSide } = author;
---

<BaseLayout
  title={`Peta Baca — ${author.penName}`}
  description="Ikuti urutan baca agar tidak ada kejutan yang bocor duluan. Semua dibaca di KBM App."
>
  <SiteHeader penName={author.penName} currentPath="/peta-baca" />

  <main class="flex flex-col">
    <section class="pt-9 pb-1 px-5 bg-gradient-to-b from-blush to-paper">
      <span class="text-[11px] tracking-[.16em] text-alert font-semibold">PETA BACA</span>
      <h1 class="mt-2 mb-[10px] font-serif text-[32px] font-semibold leading-[1.2] text-ink">
        Mulai dari mana?
      </h1>
      <p class="m-0 mb-6 text-[15px] leading-[1.7] text-ink-soft">
        Ikuti urutan ini supaya tidak ada kejutan yang bocor duluan. Semua dibaca di KBM App.
      </p>
    </section>

    <!-- Main reading order -->
    {readingMain && readingMain.length > 0 && (
      <section class="px-5 mb-7">
        <h2 class="m-0 mb-[14px] font-serif text-[22px] font-semibold text-ink">
          Semesta &ldquo;Istri Kedua&rdquo;
        </h2>
        <div class="flex flex-col">
          {readingMain.map((node, i) => {
            const isLast = i === readingMain.length - 1;
            return (
              <div class="flex flex-col">
                <div
                  class="flex gap-[14px] bg-card border-[1.5px] rounded-[18px] p-4 shadow-[0_2px_12px_rgba(92,36,48,.06)]"
                  style={{ borderColor: node.border }}
                >
                  <div
                    class="flex-none w-[58px] aspect-[2/3] rounded-[5px] flex items-center justify-center p-[6px]"
                    style={{ background: node.coverBg }}
                  >
                    <span class="font-serif text-[9px] font-semibold leading-[1.3] text-paper text-center">
                      {node.title}
                    </span>
                  </div>
                  <div class="flex-1 flex flex-col gap-1">
                    <span
                      class="self-start text-[10px] tracking-[.12em] font-semibold rounded-full py-1 px-[10px]"
                      style={{ color: node.badgeColor, background: node.badgeBg }}
                    >
                      {node.badge}
                    </span>
                    <h3 class="mt-[2px] mb-0 font-serif text-[19px] font-semibold leading-[1.25] text-ink">
                      {node.title}
                    </h3>
                    <p class="m-0 text-[13px] leading-[1.55] text-ink-soft">
                      {node.desc}
                    </p>
                    <a
                      href={node.kbmUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-2 flex items-center justify-center min-h-[44px] bg-rose text-paper rounded-[11px] text-[14px] font-semibold no-underline"
                    >
                      Baca di KBM &rarr;
                    </a>
                  </div>
                </div>
                {node.showArrow && !isLast && (
                  <div class="flex flex-col items-center py-[6px]">
                    <span class="w-[1.5px] h-4 bg-[#C99B94]"></span>
                    <span class="text-[11px] text-alert tracking-[.08em] py-[3px]">lalu lanjut ke</span>
                    <span class="w-[1.5px] h-4 bg-[#C99B94]"></span>
                    <span class="text-alert text-[13px] leading-none">&#9660;</span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- Side reads (standalone) -->
    {readingSide && readingSide.length > 0 && (
      <section class="px-5 pb-11">
        <h2 class="m-0 mb-1 font-serif text-[22px] font-semibold text-ink">
          Bisa dibaca kapan saja
        </h2>
        <p class="m-0 mb-[14px] text-[13px] leading-[1.6] text-muted">
          Dua novel lepas &mdash; tidak terhubung dengan semesta mana pun.
        </p>
        <div class="flex flex-col gap-3">
          {readingSide.map((node) => (
            <div class="flex gap-[14px] items-center bg-card border border-rose/16 rounded-[16px] py-[14px] px-4">
              <div
                class="flex-none w-[46px] aspect-[2/3] rounded-[4px] flex items-center justify-center p-[5px]"
                style={{ background: node.coverBg }}
              >
                <span class="font-serif text-[8px] font-semibold leading-[1.3] text-paper text-center">
                  {node.title}
                </span>
              </div>
              <div class="flex-1">
                <h3 class="m-0 mb-[2px] font-serif text-[17px] font-semibold text-ink leading-[1.3]">
                  {node.title}
                </h3>
                <p class="m-0 text-[12px] text-faint">{node.desc}</p>
              </div>
              <a
                href={node.kbmUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-none flex items-center justify-center min-h-[44px] px-[14px] border-[1.5px] border-rose text-rose rounded-[11px] text-[13px] font-semibold no-underline"
              >
                Baca &rarr;
              </a>
            </div>
          ))}
        </div>
      </section>
    )}
  </main>

  <SiteFooter author={author} />
</BaseLayout>
