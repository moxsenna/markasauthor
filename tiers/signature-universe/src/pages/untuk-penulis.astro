---
import OpsLayout from '../layouts/OpsLayout.astro';
import OpsNav from '../components/ops/OpsNav.astro';
import TelegramMock from '../components/ops/TelegramMock.astro';
import authorData from '../data/author.json';
import type { AuthorData } from '../lib/types';

const author = authorData as AuthorData;
---

<OpsLayout penName={author.penName} activeTab="telegram">
  <OpsNav slot="nav" activeTab="telegram" />

  <div style="margin-bottom:12px;display:flex;align-items:center;gap:16px;flex-wrap:wrap">
    <a
      href="/dashboard"
      style="font-size:13px;color:#7A5A50;text-decoration:none;display:inline-flex;align-items:center;gap:4px"
    >
      ← Dashboard
    </a>
    <a
      href="/"
      style="font-size:13px;color:#7A5A50;text-decoration:none;display:inline-flex;align-items:center;gap:4px"
    >
      ← Beranda
    </a>
  </div>

  <h1
    style="margin:0 0 6px;font-family:'Playfair Display',serif;font-size:32px;font-weight:600;color:#3B2A28"
  >
    Simulasi Telegram
  </h1>
  <p style="margin:0 0 20px;max-width:620px;font-size:14px;line-height:1.6;color:#7A5A50">
    Notifikasi &amp; aksi cepat dari HP — simulasi frontend, bukan bot asli. Data disimpan di
    <em>localStorage</em>.
  </p>

  <TelegramMock />
</OpsLayout>
