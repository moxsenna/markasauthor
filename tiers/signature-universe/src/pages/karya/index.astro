---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/public/SiteHeader.astro';
import SiteFooter from '../../components/public/SiteFooter.astro';
import authorData from '../../data/author.json';
import type { AuthorData } from '../../lib/types';

const author = authorData as AuthorData;
const works = author.works;
---

<BaseLayout
  title={`Karya — ${author.penName}`}
  description={`Daftar karya ${author.penName}`}
>
  <SiteHeader penName={author.penName} currentPath="/karya" />

  <main class="flex flex-col">
    <section class="pt-9 pb-1 px-5 bg-gradient-to-b from-blush to-paper">
      <span class="text-[11px] tracking-[.16em] text-alert font-semibold">KATALOG</span>
      <h1 class="mt-2 mb-[10px] font-serif text-[32px] font-semibold leading-[1.2] text-ink">
        Karya
      </h1>
      <p class="m-0 mb-6 text-[15px] leading-[1.7] text-ink-soft">
        Semua karya {author.penName} &mdash; dibaca gratis lewat KBM App.
      </p>
    </section>

    <section class="px-5 pb-11">
      <div class="flex flex-col gap-4">
        {works.map((work) => (
          <a
            href={`/karya/${work.slug}`}
            class="flex items-center gap-[14px] bg-card border border-rose/16 rounded-[16px] py-[14px] px-4 no-underline hover:shadow-[0_4px_14px_rgba(92,36,48,.1)] transition-shadow"
          >
            <div
              class="flex-none w-[46px] aspect-[2/3] rounded-[4px] flex items-center justify-center p-[5px]"
              style={{ background: work.coverBg }}
            >
              <span class="font-serif text-[8px] font-semibold leading-[1.3] text-paper text-center">
                {work.title}
              </span>
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <h3 class="m-0 font-serif text-[17px] font-semibold text-ink leading-[1.3]">
                  {work.title}
                </h3>
                {work.series && (
                  <span class="text-[10px] tracking-[.1em] font-semibold text-faint border border-rose/20 rounded-full py-[3px] px-[8px]">
                    {work.series}
                  </span>
                )}
              </div>
              <p class="mt-[3px] mb-0 text-[12px] text-faint">{work.readers} &middot; {work.status}</p>
            </div>
            <span class="flex-none text-rose text-[13px] font-semibold">&rarr;</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter author={author} />
</BaseLayout>
