---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/public/SiteHeader.astro';
import SiteFooter from '../components/public/SiteFooter.astro';
import authorData from '../data/author.json';
import type { AuthorData, BonusItem } from '../lib/types';

const author = authorData as AuthorData;
const bonuses: BonusItem[] = author.bonuses;
---

<BaseLayout
  title={`Ruang Bonus — ${author.penName}`}
  description="Cerita di balik cerita: adegan yang dipotong, sudut pandang tokoh lain, dan surat yang tak pernah sampai."
>
  <SiteHeader penName={author.penName} currentPath="/bonus" />

  <main class="flex flex-col">
    <section class="pt-9 pb-2 px-5 bg-gradient-to-b from-blush to-paper">
      <span class="text-[11px] tracking-[.16em] text-alert font-semibold">KHUSUS PEMBACA</span>
      <h1 class="mt-2 mb-[10px] font-serif text-[32px] font-semibold leading-[1.2] text-ink">
        Ruang Bonus Pembaca
      </h1>
      <p class="m-0 mb-6 text-[15px] leading-[1.7] text-ink-soft">
        Cerita di balik cerita: adegan yang dipotong, sudut pandang tokoh lain, dan surat yang tak pernah sampai. Tidak ada di KBM &mdash; hanya di sini.
      </p>
    </section>

    <!-- Locked gate: form -->
    <div id="bonus-locked" class="px-5">
      <!-- Locked preview cards -->
      <section class="flex flex-col gap-3 mb-4">
        {bonuses.map((b) => (
          <article class="bg-card border border-rose/16 rounded-[18px] p-[18px_20px] flex items-center gap-[14px]">
            <div class="flex-1">
              <span class="text-[10px] tracking-[.14em] text-faint font-semibold">{b.jenis}</span>
              <h3 class="mt-[5px] mb-[3px] font-serif text-[18px] font-semibold leading-[1.3] text-ink">{b.title}</h3>
              <p class="m-0 text-[12px] text-faint italic">dari &ldquo;{b.karya}&rdquo;</p>
            </div>
            <span class="flex-none text-[10px] tracking-[.1em] font-semibold text-muted border border-rose/25 rounded-full py-[6px] px-[10px]">TERKUNCI</span>
          </article>
        ))}
      </section>

      <!-- Gate form -->
      <section class="mb-10 bg-rose-deep rounded-[22px] py-7 px-6 text-blush">
        <h2 class="m-0 mb-[6px] font-serif text-[23px] font-semibold leading-[1.3] text-paper">
          Buka semua bonus &mdash; gratis
        </h2>
        <p class="m-0 mb-[18px] text-[14px] leading-[1.65] text-[#E3C6C0]">
          Cukup tinggalkan nama dan nomor WhatsApp. Bonus langsung terbuka, dan kamu dapat kabar setiap bab baru terbit.
        </p>
        <form id="bonus-gate-form" class="flex flex-col gap-[10px]">
          <input
            type="text"
            id="bonus-nama"
            placeholder="Nama panggilanmu"
            class="min-h-[50px] px-4 rounded-[12px] border border-paper/25 bg-paper text-ink font-body text-[16px] placeholder:text-[#B39A90]"
            required
          />
          <input
            type="tel"
            id="bonus-wa"
            placeholder="Nomor WhatsApp (08&hellip;)"
            class="min-h-[50px] px-4 rounded-[12px] border border-paper/25 bg-paper text-ink font-body text-[16px] placeholder:text-[#B39A90]"
            required
          />
          <p id="bonus-error" class="hidden m-0 text-[13px] text-[#F0B9A8]"></p>
          <button
            type="submit"
            class="min-h-[52px] bg-[#D8A7A4] text-[#4A1D26] border-none rounded-[12px] font-body text-[16px] font-semibold cursor-pointer"
          >
            Buka Bonus Sekarang
          </button>
        </form>
        <p class="mt-[14px] mb-0 text-[12px] leading-[1.6] text-[#C99B94]">
          Nomormu aman, hanya untuk kabar rilis &mdash; tidak dibagikan ke siapa pun.
        </p>
      </section>
    </div>

    <!-- Unlocked state: bonus list with excerpts (hidden by default, shown by client script) -->
    <div id="bonus-unlocked" class="hidden px-5">
      <div class="flex items-center gap-[10px] bg-[#EAF3EC] border border-wa/25 rounded-[14px] py-3 px-4 mb-6">
        <span class="w-[22px] h-[22px] rounded-full bg-wa text-paper flex items-center justify-center text-[12px] flex-none">&#10003;</span>
        <p class="m-0 text-[14px] text-[#25543F] leading-[1.5]">
          Selamat datang kembali, <strong id="bonus-reader-name">Pembaca</strong>. Semua bonus terbuka untukmu.
        </p>
      </div>

      <div class="flex flex-col gap-[14px] mb-10">
        {bonuses.map((b) => (
          <article class="bg-card border border-rose/16 rounded-[18px] p-5 shadow-[0_2px_12px_rgba(92,36,48,.06)]">
            <span class="text-[10px] tracking-[.14em] text-faint font-semibold">{b.jenis}</span>
            <h3 class="mt-[6px] mb-1 font-serif text-[21px] font-semibold leading-[1.3] text-ink">{b.title}</h3>
            <p class="m-0 mb-3 text-[12px] text-faint italic">dari &ldquo;{b.karya}&rdquo;</p>
            <p class="m-0 mb-[14px] text-[14px] leading-[1.65] text-ink-soft">{b.teaser}</p>
            <button
              type="button"
              class="bonus-toggle-btn flex items-center justify-center min-h-[46px] w-full bg-rose text-paper rounded-[12px] text-[14px] font-semibold border-none cursor-pointer"
              data-bonus-id={b.id}
            >
              Baca Sekarang
            </button>
            <div class="bonus-excerpt hidden mt-[14px] border-l-[2px] border-[#D8A7A4] py-1 pl-4">
              <p class="m-0 text-[15px] leading-[1.8] text-ink-soft italic">{b.excerpt}</p>
              <p class="mt-[10px] mb-0 text-[12px] text-faint">&mdash; cuplikan pembuka &middot; versi lengkap ada di bawah</p>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-[6px] mb-10 text-[12px] leading-[1.6] text-faint">
        Semua bonus adalah materi pelengkap &mdash; kelanjutan cerita hanya terbit di KBM App.
      </p>
    </div>
  </main>

  <SiteFooter author={author} />

  <script type="application/json" id="bonus-fallback-data">
    {JSON.stringify(author.latestChapters)}
  </script>

  <script>
    import { unlockReader, loadDemoState } from '../lib/demo-store';
    import type { LatestChapter } from '../lib/types';

    const fallbackEl = document.getElementById('bonus-fallback-data');
    const fallbackChapters: LatestChapter[] = fallbackEl ? JSON.parse(fallbackEl.textContent || '[]') : [];

    const lockedDiv = document.getElementById('bonus-locked');
    const unlockedDiv = document.getElementById('bonus-unlocked');
    const form = document.getElementById('bonus-gate-form') as HTMLFormElement | null;
    const namaInput = document.getElementById('bonus-nama') as HTMLInputElement | null;
    const waInput = document.getElementById('bonus-wa') as HTMLInputElement | null;
    const errorEl = document.getElementById('bonus-error');
    const readerNameEl = document.getElementById('bonus-reader-name');

    // Check if already unlocked
    const state = loadDemoState('signature', fallbackChapters);
    if (state.unlocked && state.readerName) {
      showUnlocked(state.readerName);
    }

    function showUnlocked(name: string) {
      if (lockedDiv) lockedDiv.classList.add('hidden');
      if (unlockedDiv) unlockedDiv.classList.remove('hidden');
      if (readerNameEl) readerNameEl.textContent = name;
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      if (errorEl) errorEl.classList.add('hidden');

      const nama = (namaInput?.value ?? '').trim();
      const waRaw = (waInput?.value ?? '').replace(/[^0-9+]/g, '');

      if (!nama || waRaw.length < 9) {
        if (errorEl) {
          errorEl.textContent = 'Mohon isi nama dan nomor WhatsApp yang benar, ya.';
          errorEl.classList.remove('hidden');
        }
        return;
      }

      // Unlock with signature tier
      unlockReader('signature', nama, fallbackChapters);
      showUnlocked(nama);

      // Redirect to thank-you
      window.location.href = '/bonus/terima-kasih';
    });

    // Bonus excerpt toggle
    document.querySelectorAll('.bonus-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const article = btn.closest('article');
        const excerpt = article?.querySelector('.bonus-excerpt') as HTMLElement | null;
        if (excerpt) {
          const isHidden = excerpt.classList.contains('hidden');
          excerpt.classList.toggle('hidden');
          btn.textContent = isHidden ? 'Tutup Cuplikan' : 'Baca Sekarang';
        }
      });
    });
  </script>
</BaseLayout>
