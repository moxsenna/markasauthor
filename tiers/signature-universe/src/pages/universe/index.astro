---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/public/SiteHeader.astro';
import SiteFooter from '../../components/public/SiteFooter.astro';
import authorData from '../../data/author.json';
import type { AuthorData } from '../../lib/types';

const author = authorData as AuthorData;
const universe = author.universe;

if (!universe) {
  return Astro.redirect('/');
}

const { name, blurb, characters, storyTimeline, locations, trivia, playlistUrl } = universe;
---

<BaseLayout
  title={`Semesta ${name} — ${author.penName}`}
  description={blurb}
>
  <SiteHeader penName={author.penName} currentPath="/universe" />

  <main class="flex flex-col">
    <!-- Hero / Header -->
    <section class="pt-10 pb-2 px-5 bg-gradient-to-b from-[#EFD8D2] via-blush to-paper">
      <span class="text-[11px] tracking-[.16em] text-alert font-semibold">SEMESTA</span>
      <h1 class="mt-2 mb-[10px] font-serif text-[32px] font-semibold leading-[1.2] text-ink">
        {name}
      </h1>
      <p class="m-0 mb-6 text-[15px] leading-[1.7] text-ink-soft">
        {blurb}
      </p>
    </section>

    <!-- Stats row -->
    <section class="px-5 mb-7">
      <div class="flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-[6px] text-[13px] text-ink-soft bg-blush border border-rose/14 rounded-full py-[7px] px-[14px]">
          <span class="text-rose font-semibold">{characters.length}</span> tokoh
        </span>
        <span class="inline-flex items-center gap-[6px] text-[13px] text-ink-soft bg-blush border border-rose/14 rounded-full py-[7px] px-[14px]">
          <span class="text-rose font-semibold">{storyTimeline.length}</span> tonggak
        </span>
        <span class="inline-flex items-center gap-[6px] text-[13px] text-ink-soft bg-blush border border-rose/14 rounded-full py-[7px] px-[14px]">
          <span class="text-rose font-semibold">{locations.length}</span> lokasi
        </span>
        <span class="inline-flex items-center gap-[6px] text-[13px] text-ink-soft bg-blush border border-rose/14 rounded-full py-[7px] px-[14px]">
          <span class="text-rose font-semibold">{trivia.length}</span> trivia
        </span>
      </div>
    </section>

    <!-- Navigation Cards -->
    <section class="px-5 pb-11">
      <h2 class="m-0 mb-[14px] font-serif text-[22px] font-semibold text-ink">
        Jelajahi semesta
      </h2>

      <div class="flex flex-col gap-[10px]">
        <!-- Tokoh card -->
        <a
          href="/universe/tokoh"
          class="flex items-center gap-[14px] bg-gradient-to-r from-[#F4E3DE] to-[#FBF6EF] border border-rose/16 rounded-[16px] py-[18px] px-5 no-underline hover:shadow-[0_4px_14px_rgba(92,36,48,.12)] transition-shadow"
        >
          <div class="flex-none w-[48px] h-[48px] rounded-full bg-rose flex items-center justify-center text-[20px] text-paper">
            &#128100;
          </div>
          <div class="flex-1">
            <h3 class="m-0 font-serif text-[18px] font-semibold text-ink leading-[1.3]">Tokoh</h3>
            <p class="mt-[3px] mb-0 text-[13px] text-muted">{characters.length} karakter &mdash; dari protagonis sampai tokoh silang</p>
          </div>
          <span class="flex-none text-rose text-[15px] font-semibold">&rarr;</span>
        </a>

        <!-- Timeline card -->
        <a
          href="/universe/timeline"
          class="flex items-center gap-[14px] bg-gradient-to-r from-[#F4E3DE] to-[#FBF6EF] border border-rose/16 rounded-[16px] py-[18px] px-5 no-underline hover:shadow-[0_4px_14px_rgba(92,36,48,.12)] transition-shadow"
        >
          <div class="flex-none w-[48px] h-[48px] rounded-full bg-rose flex items-center justify-center text-[20px] text-paper">
            &#9203;
          </div>
          <div class="flex-1">
            <h3 class="m-0 font-serif text-[18px] font-semibold text-ink leading-[1.3]">Linimasa</h3>
            <p class="mt-[3px] mb-0 text-[13px] text-muted">Tonggak cerita &mdash; dari awal sampai klimaks. Yang spoiler disamarkan.</p>
          </div>
          <span class="flex-none text-rose text-[15px] font-semibold">&rarr;</span>
        </a>

        <!-- Peta card -->
        <a
          href="/universe/peta"
          class="flex items-center gap-[14px] bg-gradient-to-r from-[#F4E3DE] to-[#FBF6EF] border border-rose/16 rounded-[16px] py-[18px] px-5 no-underline hover:shadow-[0_4px_14px_rgba(92,36,48,.12)] transition-shadow"
        >
          <div class="flex-none w-[48px] h-[48px] rounded-full bg-rose flex items-center justify-center text-[20px] text-paper">
            &#128506;
          </div>
          <div class="flex-1">
            <h3 class="m-0 font-serif text-[18px] font-semibold text-ink leading-[1.3]">Peta</h3>
            <p class="mt-[3px] mb-0 text-[13px] text-muted">Lokasi penting dalam cerita &mdash; dari rumah sampai dapur.</p>
          </div>
          <span class="flex-none text-rose text-[15px] font-semibold">&rarr;</span>
        </a>

        <!-- Trivia card -->
        <a
          href="/universe/trivia"
          class="flex items-center gap-[14px] bg-gradient-to-r from-[#F4E3DE] to-[#FBF6EF] border border-rose/16 rounded-[16px] py-[18px] px-5 no-underline hover:shadow-[0_4px_14px_rgba(92,36,48,.12)] transition-shadow"
        >
          <div class="flex-none w-[48px] h-[48px] rounded-full bg-rose flex items-center justify-center text-[20px] text-paper">
            &#10067;
          </div>
          <div class="flex-1">
            <h3 class="m-0 font-serif text-[18px] font-semibold text-ink leading-[1.3]">Trivia</h3>
            <p class="mt-[3px] mb-0 text-[13px] text-muted">Di balik layar penciptaan semesta &mdash; Q&amp;A ringan.</p>
          </div>
          <span class="flex-none text-rose text-[15px] font-semibold">&rarr;</span>
        </a>

        {playlistUrl && (
          <a
            href={playlistUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-[14px] bg-gradient-to-r from-[#EFD8D2] to-[#FBF6EF] border border-rose/12 rounded-[16px] py-[18px] px-5 no-underline hover:shadow-[0_4px_14px_rgba(92,36,48,.12)] transition-shadow"
          >
            <div class="flex-none w-[48px] h-[48px] rounded-full bg-[#1DB954] flex items-center justify-center text-[20px] text-paper">
              &#9835;
            </div>
            <div class="flex-1">
              <h3 class="m-0 font-serif text-[18px] font-semibold text-ink leading-[1.3]">Playlist</h3>
              <p class="mt-[3px] mb-0 text-[13px] text-muted">Dengarkan lagu yang mengiringi penciptaan semesta ini &mdash; Spotify</p>
            </div>
            <span class="flex-none text-[#1DB954] text-[15px] font-semibold">&nearr;</span>
          </a>
        )}
      </div>
    </section>
  </main>

  <SiteFooter author={author} />
</BaseLayout>
