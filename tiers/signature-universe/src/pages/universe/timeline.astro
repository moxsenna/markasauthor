---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/public/SiteHeader.astro';
import SiteFooter from '../../components/public/SiteFooter.astro';
import authorData from '../../data/author.json';
import type { AuthorData } from '../../lib/types';

const author = authorData as AuthorData;
const universe = author.universe;

if (!universe) {
  return Astro.redirect('/universe');
}

const { name, storyTimeline } = universe;
---

<BaseLayout
  title={`Linimasa — Semesta ${name} — ${author.penName}`}
  description={`Tonggak cerita dalam semesta ${name}`}
>
  <SiteHeader penName={author.penName} currentPath="/universe" />

  <main class="flex flex-col">
    <section class="pt-9 pb-2 px-5 bg-gradient-to-b from-blush to-paper">
      <a href="/universe" class="text-[11px] tracking-[.1em] text-faint font-semibold no-underline">&larr; Semesta {name}</a>
      <h1 class="mt-2 mb-[10px] font-serif text-[32px] font-semibold leading-[1.2] text-ink">
        Linimasa Cerita
      </h1>
      <p class="m-0 mb-6 text-[15px] leading-[1.7] text-ink-soft">
        Tonggak-tonggak penting dalam semesta ini. Beberapa disamarkan karena mengandung spoiler &mdash; klik untuk membukanya.
      </p>
    </section>

    <section class="px-5 pb-11">
      <!-- Vertical Timeline -->
      <div class="flex flex-col">
        {storyTimeline.map((item, i) => {
          const isLast = i === storyTimeline.length - 1;
          return (
            <div class="flex gap-[14px]">
              <!-- Dot + line -->
              <div class="flex flex-col items-center flex-none pt-[6px]">
                <div
                  class={`w-[14px] h-[14px] rounded-full border-[2.5px] border-rose flex-none ${item.spoiler ? 'bg-blush' : 'bg-rose'}`}
                ></div>
                {!isLast && (
                  <div class="w-[1.5px] flex-1 min-h-[20px] bg-rose/25 mt-[4px]"></div>
                )}
              </div>

              <!-- Content -->
              <div class={`flex-1 pb-6 ${isLast ? 'pb-0' : ''}`}>
                <div class={`bg-card border border-rose/16 rounded-[16px] p-[16px_18px] ${item.spoiler ? 'relative overflow-hidden' : ''}`}>
                  <h3 class="m-0 font-serif text-[17px] font-semibold text-ink leading-[1.3]">
                    {item.title}
                    {item.spoiler && (
                      <span class="inline-flex ml-2 text-[10px] tracking-[.1em] font-semibold text-alert border border-alert/30 rounded-full py-[3px] px-[8px] align-text-bottom">
                        SPOILER
                      </span>
                    )}
                  </h3>

                  {item.spoiler ? (
                    <>
                      <!-- Blur overlay -->
                      <div class="timeline-spoiler-blur mt-[8px] py-[10px] px-[14px] rounded-[10px] bg-rose/5 border border-rose/12 filter blur-[4px] select-none">
                        <p class="m-0 text-[14px] leading-[1.65] text-ink-soft">{item.body}</p>
                      </div>
                      <!-- Reveal button -->
                      <button
                        type="button"
                        class="timeline-reveal-btn mt-[8px] flex items-center gap-[6px] min-h-[38px] px-[14px] bg-rose text-paper rounded-[10px] text-[13px] font-semibold border-none cursor-pointer"
                        data-spoiler-before={item.title}
                      >
                        &#128065; Tampilkan (spoiler)
                      </button>
                      <!-- Revealed text (hidden initially) -->
                      <div class="timeline-revealed hidden mt-[8px] py-[10px] px-[14px] rounded-[10px] bg-blush border border-rose/18">
                        <p class="m-0 text-[14px] leading-[1.65] text-ink-soft">{item.body}</p>
                      </div>
                    </>
                  ) : (
                    <div class="mt-[8px] py-[10px] px-[14px] rounded-[10px] bg-blush border border-rose/12">
                      <p class="m-0 text-[14px] leading-[1.65] text-ink-soft">{item.body}</p>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Back -->
    <section class="px-5 pb-11">
      <a
        href="/universe"
        class="flex items-center justify-center min-h-[50px] bg-rose text-paper rounded-[14px] text-[15px] font-semibold no-underline"
      >
        Kembali ke Semesta &larr;
      </a>
    </section>
  </main>

  <SiteFooter author={author} />

  <script>
    // Spoiler reveal: click button to show blurred content
    document.querySelectorAll('.timeline-reveal-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.bg-card');
        if (!card) return;

        const blur = card.querySelector('.timeline-spoiler-blur') as HTMLElement | null;
        const revealed = card.querySelector('.timeline-revealed') as HTMLElement | null;

        if (blur) blur.style.display = 'none';
        if (revealed) revealed.classList.remove('hidden');
        (btn as HTMLElement).style.display = 'none';
      });
    });
  </script>
</BaseLayout>
