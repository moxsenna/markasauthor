---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/public/SiteHeader.astro';
import SiteFooter from '../../../components/public/SiteFooter.astro';
import authorData from '../../../data/author.json';
import type { AuthorData } from '../../../lib/types';

const author = authorData as AuthorData;
const universe = author.universe;

if (!universe) {
  return Astro.redirect('/universe');
}

const { characters } = universe;
---

<BaseLayout
  title={`Tokoh — Semesta ${universe.name} — ${author.penName}`}
  description={`Jelajahi tokoh-tokoh dalam semesta ${universe.name}`}
>
  <SiteHeader penName={author.penName} currentPath="/universe" />

  <main class="flex flex-col">
    <section class="pt-9 pb-2 px-5 bg-gradient-to-b from-blush to-paper">
      <a href="/universe" class="text-[11px] tracking-[.1em] text-faint font-semibold no-underline">&larr; Semesta {universe.name}</a>
      <h1 class="mt-2 mb-[10px] font-serif text-[32px] font-semibold leading-[1.2] text-ink">
        Tokoh
      </h1>
      <p class="m-0 mb-6 text-[15px] leading-[1.7] text-ink-soft">
        {characters.length} karakter yang menghidupkan semesta ini.
      </p>
    </section>

    <section class="px-5 pb-11">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {characters.map((ch) => (
          <a
            href={`/universe/tokoh/${ch.slug}`}
            class="flex flex-col bg-card border border-rose/16 rounded-[18px] py-[18px] px-5 no-underline hover:shadow-[0_4px_14px_rgba(92,36,48,.1)] transition-shadow"
          >
            <div class="flex items-center gap-[12px] mb-[10px]">
              <div
                class="flex-none w-[44px] h-[44px] rounded-full bg-rose flex items-center justify-center text-[18px] text-paper font-serif font-semibold"
              >
                {ch.name.charAt(0)}
              </div>
              <div>
                <h3 class="m-0 font-serif text-[18px] font-semibold text-ink leading-[1.3]">{ch.name}</h3>
                <span class="text-[12px] text-faint">{ch.role}</span>
              </div>
            </div>
            <p class="m-0 text-[14px] leading-[1.6] text-ink-soft italic">
              &ldquo;{ch.quote}&rdquo;
            </p>
            {ch.relations.length > 0 && (
              <p class="mt-[10px] mb-0 text-[12px] text-faint">
                Terhubung: {ch.relations.join(', ')}
              </p>
            )}
          </a>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter author={author} />
</BaseLayout>
