---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/public/SiteHeader.astro';
import SiteFooter from '../../components/public/SiteFooter.astro';
import authorData from '../../data/author.json';
import type { AuthorData } from '../../lib/types';

const author = authorData as AuthorData;
const universe = author.universe;

if (!universe) {
  return Astro.redirect('/universe');
}

const { name, trivia } = universe;
---

<BaseLayout
  title={`Trivia — Semesta ${name} — ${author.penName}`}
  description={`Tanya-jawab seputar semesta ${name}`}
>
  <SiteHeader penName={author.penName} currentPath="/universe" />

  <main class="flex flex-col">
    <section class="pt-9 pb-2 px-5 bg-gradient-to-b from-blush to-paper">
      <a href="/universe" class="text-[11px] tracking-[.1em] text-faint font-semibold no-underline">&larr; Semesta {name}</a>
      <h1 class="mt-2 mb-[10px] font-serif text-[32px] font-semibold leading-[1.2] text-ink">
        Trivia
      </h1>
      <p class="m-0 mb-6 text-[15px] leading-[1.7] text-ink-soft">
        Di balik layar penciptaan semesta ini &mdash; tanya-jawab ringan.
      </p>
    </section>

    <section class="px-5 pb-11">
      <div class="flex flex-col gap-3">
        {trivia.map((item, i) => (
          <div
            class="bg-card border border-rose/16 rounded-[16px] overflow-hidden"
          >
            <button
              type="button"
              class="trivia-toggle-btn flex items-center justify-between w-full py-[16px] px-5 bg-transparent border-none cursor-pointer text-left font-body"
              aria-expanded="false"
            >
              <div class="flex items-center gap-[10px] min-w-0">
                <span class="flex-none text-[11px] tracking-[.1em] text-faint font-semibold">Q{i + 1}</span>
                <span class="font-serif text-[16px] font-semibold text-ink leading-[1.3]">{item.q}</span>
              </div>
              <span class="trivia-arrow flex-none text-rose text-[14px] transition-transform ml-3">&#9660;</span>
            </button>
            <div class="trivia-answer hidden px-5 pb-[16px] pt-0 border-t border-rose/10 mx-5">
              <p class="m-0 text-[14px] leading-[1.65] text-ink-soft">{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Back -->
    <section class="px-5 pb-11">
      <a
        href="/universe"
        class="flex items-center justify-center min-h-[50px] bg-rose text-paper rounded-[14px] text-[15px] font-semibold no-underline"
      >
        Kembali ke Semesta &larr;
      </a>
    </section>
  </main>

  <SiteFooter author={author} />

  <script>
    // Accordion toggle
    document.querySelectorAll('.trivia-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const answer = btn.nextElementSibling as HTMLElement | null;
        const arrow = btn.querySelector('.trivia-arrow') as HTMLElement | null;
        const expanded = btn.getAttribute('aria-expanded') === 'true';

        if (answer) {
          answer.classList.toggle('hidden');
        }
        if (arrow) {
          arrow.style.transform = expanded ? 'rotate(0deg)' : 'rotate(180deg)';
        }
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      });
    });
  </script>
</BaseLayout>
